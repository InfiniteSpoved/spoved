{{/* The secret alert list of the organization's Security tab and the instance page: .Secrets is the shared/security SecretsPage */}}
{{$s := .Secrets}}
	<form class="security-search-form" method="get" action="{{$s.Link}}">
		<label>{{ctx.Locale.Tr "security_search.state"}}
			<select name="state">
				<option value=""{{if not $s.Form.State}} selected{{end}}>{{ctx.Locale.Tr "secret_search.state_all"}}</option>
				<option value="open"{{if eq $s.Form.State "open"}} selected{{end}}>{{ctx.Locale.Tr "secret_search.state_open"}}</option>
				<option value="closed"{{if eq $s.Form.State "closed"}} selected{{end}}>{{ctx.Locale.Tr "secret_search.state_closed"}}</option>
			</select>
		</label>
		<label>{{ctx.Locale.Tr "repo.secrets.reason"}}
			<select name="reason">
				<option value="">{{ctx.Locale.Tr "repo.secrets.all_reasons"}}</option>
				{{range $s.ClosedStates}}<option value="{{.}}"{{if eq . $s.Form.Reason}} selected{{end}}>{{ctx.Locale.Tr (printf "repo.secrets.reason.%s" .)}}</option>{{end}}
			</select>
		</label>
		<label>{{ctx.Locale.Tr "repo.secrets.type"}}
			<select name="type">
				<option value="">{{ctx.Locale.Tr "repo.secrets.all_types"}}</option>
				{{range $s.Types}}<option value="{{.ID}}"{{if eq .ID $s.Form.Type}} selected{{end}}>{{.Name}}</option>{{end}}
			</select>
		</label>
		<label class="security-search-wide">{{ctx.Locale.Tr "secret_search.search"}}
			<input type="search" name="q" value="{{$s.Form.Query}}" maxlength="128" placeholder="{{ctx.Locale.Tr "secret_search.search"}}">
		</label>
		{{if $s.Admin}}
			<label>{{ctx.Locale.Tr "security_search.owner"}}
				<input name="owner" value="{{$s.Form.Owner}}" maxlength="255" placeholder="{{ctx.Locale.Tr "security_search.owner_placeholder"}}">
			</label>
		{{else if $s.Projects}}
			<label>{{ctx.Locale.Tr "security_search.project"}}
				<select name="project">
					<option value="">{{ctx.Locale.Tr "security_search.all"}}</option>
					{{range $s.Projects}}<option value="{{.Name}}"{{if eq .Name $s.Form.Project}} selected{{end}}>{{.Name}}</option>{{end}}
				</select>
			</label>
		{{end}}
		<button class="ui primary button" type="submit">{{ctx.Locale.Tr "security_search.search"}}</button>
	</form>

	{{if $s.Ignored}}<div class="ui warning message" id="secret-filter-ignored" role="alert">{{ctx.Locale.Tr "secret_search.filter_ignored"}}</div>{{end}}
	{{if not $s.Result.Total}}
		<div class="ui info message" id="secret-search-none">
			{{if $s.HasFilter}}{{ctx.Locale.Tr "secret_search.none"}} <a href="{{$s.Link}}">{{ctx.Locale.Tr "security_search.clear"}}</a>{{else}}{{ctx.Locale.Tr "secret_search.none_yet"}}{{end}}
		</div>
	{{else}}
		<div class="security-search-bar">
			<strong id="secret-search-total">
				{{ctx.Locale.TrPluralString $s.Result.Total "secret_search.alerts" (ctx.Locale.PrettyNumber $s.Result.Total)}}
				{{ctx.Locale.TrPluralString $s.Result.Repos "secret_search.in_repos" (ctx.Locale.PrettyNumber $s.Result.Repos)}}
			</strong>
			<form method="post" action="{{$s.Link}}/export">
				{{range $k, $v := $s.Form.Values}}{{range $v}}<input type="hidden" name="{{$k}}" value="{{.}}">{{end}}{{end}}
				<button class="ui basic small button" type="submit" id="secret-export">{{svg "octicon-download"}} {{ctx.Locale.Tr "security_search.download_csv"}}</button>
			</form>
		</div>
		<p class="security-search-note">{{ctx.Locale.Tr "secret_search.csv_columns"}}</p>
		<table class="security-search-table secret-search-table">
			<thead>
				<tr>
					<th>{{ctx.Locale.Tr "security_search.repository"}}</th>
					<th>{{ctx.Locale.Tr "repo.secrets.type"}}</th>
					<th>{{ctx.Locale.Tr "repo.secrets.first_location"}}</th>
					<th>{{ctx.Locale.Tr "repo.secrets.state"}}</th>
					<th>{{ctx.Locale.Tr "repo.secrets.first_seen"}}</th>
				</tr>
			</thead>
			<tbody>
				{{range $s.Result.Hits}}
					<tr>
						<td><a href="{{.Repo.Link}}">{{.Repo.FullName}}</a></td>
						<td>
							<a href="{{.Repo.Link}}/security/secrets/{{.Index}}"><strong>{{.Name}}</strong></a>
							{{if .Generic}}<span class="ui mini yellow label">{{ctx.Locale.Tr "repo.secrets.generic"}}</span>{{end}}
						</td>
						<td>
							<span class="security-search-cl">{{ctx.Locale.Tr "repo.secrets.first_location"}}: </span>
							{{if .First}}<code>{{.First.Path}}{{if .First.StartLine}}:{{.First.StartLine}}{{end}}</code>{{end}}
							{{if .More}} <span class="text grey small">{{ctx.Locale.Tr "repo.secrets.more" (ctx.Locale.PrettyNumber .More)}}</span>{{end}}
						</td>
						<td>
							<span class="security-search-cl">{{ctx.Locale.Tr "repo.secrets.state"}}: </span>
							{{if eq .State "open"}}<span class="ui small label vuln-state vuln-state-open">{{ctx.Locale.Tr "repo.secrets.state.open"}}</span>
							{{else}}
								{{if eq .State "wont_fix"}}<span class="ui small label vuln-state-warning">{{ctx.Locale.Tr (printf "repo.secrets.closed_as.%s" .State)}}</span>
								{{else}}<span class="ui small basic label">{{ctx.Locale.Tr (printf "repo.secrets.closed_as.%s" .State)}}</span>{{end}}
								<span class="text grey small">{{if .ClosedBy}}{{.ClosedBy.GetDisplayName}}, {{end}}{{DateUtils.TimeSince .ClosedUnix}}</span>
							{{end}}
						</td>
						<td><span class="security-search-cl">{{ctx.Locale.Tr "repo.secrets.first_seen"}}: </span>{{DateUtils.TimeSince .CreatedUnix}}</td>
					</tr>
				{{end}}
			</tbody>
		</table>
		{{template "base/paginate" .}}
	{{end}}
	<p class="security-search-note" id="secret-search-note">{{if $s.Admin}}{{ctx.Locale.Tr "secret_search.admin_note"}}{{else if $s.Narrow}}{{ctx.Locale.Tr "secret_search.org_note"}}{{else}}{{ctx.Locale.Tr "secret_search.org_note_all"}}{{end}}</p>
