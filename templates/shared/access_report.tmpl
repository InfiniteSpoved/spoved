{{/* Lines: []*api.AccessReportLine; ShowPeople: show the person columns (site admins only) */}}
<h4 class="ui top attached header">
	{{ctx.Locale.Tr "access_report.report"}}
	<div class="ui right">
		<a class="ui primary tiny button" href="{{.CSVLink}}">{{ctx.Locale.Tr "access_report.export_csv"}}</a>
		<a class="ui primary tiny button" href="{{.JSONLink}}">{{ctx.Locale.Tr "access_report.export_json"}}</a>
	</div>
</h4>
<div class="ui attached segment">
	<form class="ui form" method="get">
		<div class="fields">
			<div class="field">
				<label for="access-mode">{{ctx.Locale.Tr "access_report.access"}}</label>
				<select id="access-mode" name="mode">
					<option value="">{{ctx.Locale.Tr "access_report.filter.any"}}</option>
					{{range $m := StringUtils.Make "read" "write" "admin"}}
						<option value="{{$m}}"{{if eq ($.Filter.Get "mode") $m}} selected{{end}}>{{ctx.Locale.Tr (print "access_report.mode." $m)}}</option>
					{{end}}
				</select>
			</div>
			<div class="field">
				<label for="access-unit">{{ctx.Locale.Tr "access_report.unit"}}</label>
				<select id="access-unit" name="unit">
					<option value="">{{ctx.Locale.Tr "access_report.filter.any"}}</option>
					{{range $.Units}}
						<option value="{{.NameKey}}"{{if eq ($.Filter.Get "unit") .NameKey}} selected{{end}}>{{ctx.Locale.Tr .NameKey}}</option>
					{{end}}
				</select>
			</div>
			<div class="field">
				<label for="access-type">{{ctx.Locale.Tr "access_report.type"}}</label>
				<select id="access-type" name="type">
					<option value="">{{ctx.Locale.Tr "access_report.filter.any"}}</option>
					{{range $t := StringUtils.Make "person" "bot" "key" "token"}}
						<option value="{{$t}}"{{if eq ($.Filter.Get "type") $t}} selected{{end}}>{{ctx.Locale.Tr (print "access_report.type." $t)}}</option>
					{{end}}
				</select>
			</div>
			{{if .ShowActivity}}
				<div class="field">
					<label for="access-inactive">{{ctx.Locale.Tr "access_report.inactive_days"}}</label>
					<input id="access-inactive" name="inactive_days" type="number" min="0" value="{{$.Filter.Get "inactive_days"}}">
				</div>
			{{end}}
			<div class="field">
				<label>&nbsp;</label>
				<div class="ui checkbox">
					<input id="access-external" name="external" type="checkbox" value="true"{{if eq ($.Filter.Get "external") "true"}} checked{{end}}>
					<label for="access-external">{{ctx.Locale.Tr "access_report.external"}}</label>
				</div>
			</div>
			<div class="field">
				<label>&nbsp;</label>
				<button class="ui primary button">{{ctx.Locale.Tr "access_report.filter"}}</button>
			</div>
		</div>
	</form>
	<div class="tw-overflow-x-auto">
		<table class="ui very basic striped table unstackable access-report-lines">
			<thead>
				<tr>
					<th>{{ctx.Locale.Tr "access_report.who"}}</th>
					<th>{{ctx.Locale.Tr "access_report.repository"}}</th>
					<th>{{ctx.Locale.Tr "access_report.unit"}}</th>
					<th>{{ctx.Locale.Tr "access_report.access"}}</th>
					<th>{{ctx.Locale.Tr "access_report.through"}}</th>
					<th>{{ctx.Locale.Tr "access_report.grant"}}</th>
					{{if .ShowPeople}}
						<th class="person-column">{{ctx.Locale.Tr "access_report.last_sign_in"}}</th>
						<th class="person-column">{{ctx.Locale.Tr "access_report.last_push"}}</th>
						<th class="person-column">{{ctx.Locale.Tr "access_report.two_factor"}}</th>
						<th class="person-column">{{ctx.Locale.Tr "access_report.account_source"}}</th>
						<th class="person-column">{{ctx.Locale.Tr "access_report.suspended"}}</th>
					{{end}}
				</tr>
			</thead>
			<tbody>
				{{range .Lines}}
					<tr data-type="{{.Type}}" data-name="{{.Name}}" data-repo="{{.Repository}}" data-unit="{{.Unit}}" data-path="{{.Path}}" data-team="{{.Team}}"{{if not .Applied}} class="text grey"{{end}}>
						<td>
							{{if .Name}}{{.Name}}{{if .FullName}} <span class="text grey">{{.FullName}}</span>{{end}}{{if eq .Type "key"}} {{svg "octicon-key"}}{{else if eq .Type "token"}} {{svg "fontawesome-send"}}{{else if eq .Type "bot"}} <span class="ui label">{{ctx.Locale.Tr "access_report.type.bot"}}</span>{{end}}
							{{else}}<em>{{ctx.Locale.Tr (print "access_report.who." .Type)}}</em>{{end}}
						</td>
						<td><a href="{{AppSubUrl}}/{{.Repository}}">{{.Repository}}</a></td>
						<td>{{if eq .Unit "*"}}{{ctx.Locale.Tr "access_report.all_units"}}{{else}}{{ctx.Locale.Tr .Unit}}{{end}}</td>
						<td>{{if .Access}}{{ctx.Locale.Tr (print "access_report.mode." .Access)}}{{end}}</td>
						<td>
							{{if .Team}}{{ctx.Locale.Tr (print "access_report.kind." .Path) .Team}}{{else}}{{ctx.Locale.Tr (print "access_report.kind." .Path)}}{{end}}
							{{range .UserGroups}} ← {{ctx.Locale.Tr "access_report.via_group" .Name}}{{if .LoginSource}} ← {{ctx.Locale.Tr "access_report.synced_by" .LoginSource}}{{end}}{{end}}
							{{if not .Applied}}({{ctx.Locale.Tr "access_report.not_applied"}}){{end}}
						</td>
						<td>{{if ne .Path "instance_roles"}}{{ctx.Locale.Tr (print "access_report.mode." .Grant)}}{{end}}</td>
						{{if $.ShowPeople}}
							{{if .Suspended}}{{/* set for users only; printing a *bool prints its value */}}
								<td>{{DateUtils.AbsoluteShort .LastLogin}}</td>
								<td class="last-push">{{DateUtils.AbsoluteShort .LastPush}}</td>
								<td>{{.TwoFactor}}</td>
								<td class="account-source">{{.AccountSource}}</td>
								<td>{{.Suspended}}</td>
							{{else}}
								<td></td><td></td><td></td><td></td><td></td>
							{{end}}
						{{end}}
					</tr>
				{{end}}
			</tbody>
		</table>
	</div>
	{{template "base/paginate" .}}
</div>
