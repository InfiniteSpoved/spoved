{{/* The custom secret patterns box: .Patterns is a PatternsPage. Read-only without .Patterns.CanWrite. */}}
{{$p := .Patterns}}
<div class="secret-patterns">
	<p class="security-search-note" id="secret-patterns-intro">{{if $p.CanWrite}}{{ctx.Locale.Tr "secret_pattern.intro"}}{{else if $p.Site}}{{ctx.Locale.Tr "secret_pattern.intro_site_reader"}}{{else}}{{ctx.Locale.Tr "secret_pattern.intro_reader"}}{{end}}</p>
	{{if $p.Locked}}<div class="ui warning message" id="secret-patterns-locked">{{ctx.Locale.Tr (printf "secret_pattern.locked_%s" $p.Locked)}}</div>{{end}}
	{{if not $p.Rows}}
		<div class="ui info message" id="secret-patterns-none">{{ctx.Locale.Tr "secret_pattern.none"}}{{if $p.CanWrite}} {{ctx.Locale.Tr "secret_pattern.none_add"}}{{end}}</div>
	{{else}}
		<table class="security-search-table secret-patterns-table">
			<thead>
				<tr>
					<th>{{ctx.Locale.Tr "secret_pattern.name"}}</th>
					<th>{{ctx.Locale.Tr "secret_pattern.keywords"}}</th>
					{{if $p.ShowText}}<th>{{ctx.Locale.Tr "secret_pattern.pattern"}}</th>{{end}}
					<th>{{ctx.Locale.Tr "secret_pattern.created_by"}}</th>
					<th>{{ctx.Locale.Tr "secret_pattern.alerts"}}</th>
					<th>{{ctx.Locale.Tr "repo.secrets.state"}}</th>
					{{if $p.CanWrite}}<th><span class="tw-sr-only">{{ctx.Locale.Tr "secret_pattern.actions"}}</span></th>{{end}}
				</tr>
			</thead>
			<tbody>
				{{range $p.Rows}}
					<tr id="pattern-{{.ID}}">
						<td><strong>{{.Name}}</strong>{{if .Site}} <span class="ui mini basic label">{{ctx.Locale.Tr "secret_pattern.site"}}</span>{{end}}</td>
						<td><span class="security-search-cl">{{ctx.Locale.Tr "secret_pattern.keywords"}}: </span>{{range .Keywords}}<code>{{.}}</code> {{end}}</td>
						{{if $p.ShowText}}<td><span class="security-search-cl">{{ctx.Locale.Tr "secret_pattern.pattern"}}: </span>{{if .Text}}<code class="tw-break-all">{{.Text}}</code>{{end}}</td>{{end}}
						<td>
							<span class="security-search-cl">{{ctx.Locale.Tr "secret_pattern.created_by"}}: </span>{{if .CreatedBy}}{{.CreatedBy}}{{else}}-{{end}}
							<div class="text grey small">{{DateUtils.AbsoluteShort .CreatedUnix}}</div>
						</td>
						<td><span class="security-search-cl">{{ctx.Locale.Tr "secret_pattern.alerts"}}: </span>{{if and .Alerts $p.ListLink}}<a href="{{$p.ListLink}}?type={{.RuleID}}&amp;state=open">{{.Alerts}}</a>{{else}}{{.Alerts}}{{end}}</td>
						<td><span class="security-search-cl">{{ctx.Locale.Tr "repo.secrets.state"}}: </span>{{if .Enabled}}<span class="ui small green label">{{ctx.Locale.Tr "secret_pattern.on"}}</span>{{else}}<span class="ui small basic label">{{ctx.Locale.Tr "secret_pattern.off"}}</span>{{end}}</td>
						{{if $p.CanWrite}}
						<td class="secret-pattern-actions">
							{{if not .Site}}
							<div class="tw-flex tw-flex-wrap tw-gap-2">
								{{if .Enabled}}
									<button type="button" class="ui small basic button" command="show-modal" commandfor="pattern-disable-{{.ID}}">{{ctx.Locale.Tr "secret_pattern.disable"}}</button>
								{{else}}
									<form method="post" action="{{$p.Link}}/{{.ID}}/enable"><button class="ui small basic button">{{ctx.Locale.Tr "secret_pattern.enable"}}</button></form>
								{{end}}
								<button type="button" class="ui small basic button" command="show-modal" commandfor="pattern-rename-{{.ID}}">{{ctx.Locale.Tr "secret_pattern.rename"}}</button>
								<button type="button" class="ui small red basic button tw-ml-4" command="show-modal" commandfor="pattern-delete-{{.ID}}">{{ctx.Locale.Tr "secret_pattern.delete"}}</button>
							</div>
							{{end}}
						</td>
						{{end}}
					</tr>
				{{end}}
			</tbody>
		</table>
	{{end}}
	{{if $p.CanWrite}}
		<p class="text grey tw-mt-3" id="secret-patterns-count">{{if $p.Site}}{{ctx.Locale.Tr "secret_pattern.count_site" $p.On $p.Cap}}{{else}}{{ctx.Locale.Tr "secret_pattern.count" $p.On $p.Cap}}{{end}}</p>
		<h5 class="ui header">{{ctx.Locale.Tr "secret_pattern.add"}}</h5>
		{{/* a refused add is shown again at the form, with the reason above the fields and tied to the marked one */}}
		<form class="ui form secret-pattern-form" id="secret-pattern-form" method="post" action="{{$p.Link}}#secret-pattern-form">
			{{$e := $p.Err}}
			<div id="secret-pattern-result">
				{{if $e}}<div class="ui negative message" role="alert" id="secret-pattern-error"><div class="header">{{$e.Title}}</div>{{$e.Text}}</div>{{end}}
			</div>
			<div class="required field{{if and $e (eq $e.Field "name")}} error{{end}}">
				<label for="secret-pattern-name">{{ctx.Locale.Tr "secret_pattern.name"}}</label>
				<input id="secret-pattern-name" name="name" maxlength="64" required value="{{$p.Form.Name}}" autocomplete="off"{{if and $e (eq $e.Field "name")}} aria-invalid="true" aria-describedby="secret-pattern-error"{{end}}>
			</div>
			<div class="required field{{if and $e (eq $e.Field "pattern")}} error{{end}}">
				<label for="secret-pattern-pattern">{{ctx.Locale.Tr "secret_pattern.pattern"}}</label>
				<input id="secret-pattern-pattern" name="pattern" class="tw-font-mono" maxlength="1024" required value="{{$p.Form.Pattern}}" autocomplete="off" spellcheck="false"{{if and $e (eq $e.Field "pattern")}} aria-invalid="true" aria-describedby="secret-pattern-error"{{end}}>
				<p class="help">{{ctx.Locale.Tr "secret_pattern.pattern_help"}}</p>
			</div>
			<div class="required field{{if and $e (eq $e.Field "keywords")}} error{{end}}">
				<label for="secret-pattern-keywords">{{ctx.Locale.Tr "secret_pattern.keywords_label"}}</label>
				<input id="secret-pattern-keywords" name="keywords" required value="{{$p.Form.Keywords}}" autocomplete="off" spellcheck="false"{{if and $e (eq $e.Field "keywords")}} aria-invalid="true" aria-describedby="secret-pattern-error"{{end}}>
				<p class="help">{{ctx.Locale.Tr "secret_pattern.keywords_help"}}</p>
			</div>
			<div class="required field{{if and $e (eq $e.Field "sample")}} error{{end}}">
				<label for="secret-pattern-sample">{{ctx.Locale.Tr "secret_pattern.sample"}}</label>
				<textarea id="secret-pattern-sample" name="sample" rows="2" maxlength="4096" required class="tw-font-mono" autocomplete="off" spellcheck="false"{{if and $e (eq $e.Field "sample")}} aria-invalid="true" aria-describedby="secret-pattern-error"{{end}}></textarea>
				<p class="help">{{ctx.Locale.Tr "secret_pattern.sample_help"}}</p>
			</div>
			<div class="tw-flex tw-gap-2 tw-flex-wrap">
				{{/* Test needs JS (it is shown by it); Add runs the same checks without it */}}
				<button type="button" class="ui basic button tw-hidden" id="secret-pattern-test" data-url="{{$p.Link}}/test" data-failed="{{ctx.Locale.Tr "secret_pattern.test_failed"}}" data-rate-limited="{{ctx.Locale.Tr "secret_pattern.test_rate_limited"}}">{{ctx.Locale.Tr "secret_pattern.test"}}</button>
				<button class="ui primary button" id="secret-pattern-add">{{ctx.Locale.Tr "secret_pattern.add_submit"}}</button>
			</div>
			<p class="help tw-mt-3">{{ctx.Locale.Tr "secret_pattern.audit_note"}}</p>
		</form>
		{{range $p.Rows}}{{if not .Site}}
			<form id="pattern-rename-form-{{.ID}}" method="post" action="{{$p.Link}}/{{.ID}}/rename"></form>
			<dialog class="modal" id="pattern-rename-{{.ID}}" aria-labelledby="pattern-rename-title-{{.ID}}">
				<article>
					<header id="pattern-rename-title-{{.ID}}">{{ctx.Locale.Tr "secret_pattern.rename_title" .Name}}</header>
					<div class="content ui form">
						<div class="field">
							<label for="pattern-rename-name-{{.ID}}">{{ctx.Locale.Tr "secret_pattern.name"}}</label>
							<input id="pattern-rename-name-{{.ID}}" name="name" form="pattern-rename-form-{{.ID}}" maxlength="64" required value="{{.Name}}" autocomplete="off">
						</div>
						<p class="help">{{ctx.Locale.Tr "secret_pattern.rename_help"}}</p>
					</div>
					<div class="actions">
						<button type="button" class="ui small basic button" command="close" commandfor="pattern-rename-{{.ID}}">{{svg "octicon-x"}} {{ctx.Locale.Tr "cancel"}}</button>
						<button class="ui small primary approve button" form="pattern-rename-form-{{.ID}}" type="submit">{{ctx.Locale.Tr "secret_pattern.rename"}}</button>
					</div>
				</article>
			</dialog>
			{{if .Enabled}}
			<form id="pattern-disable-form-{{.ID}}" method="post" action="{{$p.Link}}/{{.ID}}/disable"></form>
			<dialog class="modal" id="pattern-disable-{{.ID}}" aria-labelledby="pattern-disable-title-{{.ID}}">
				<article>
					<header id="pattern-disable-title-{{.ID}}">{{ctx.Locale.Tr "secret_pattern.disable_title" .Name}}</header>
					<div class="content"><p>{{if .Alerts}}{{ctx.Locale.TrPluralString .Alerts "secret_pattern.disable_text" (ctx.Locale.PrettyNumber .Alerts)}}{{else}}{{ctx.Locale.Tr "secret_pattern.disable_text_none"}}{{end}}</p></div>
					<div class="actions">
						<button type="button" class="ui small basic button" command="close" commandfor="pattern-disable-{{.ID}}">{{svg "octicon-x"}} {{ctx.Locale.Tr "cancel"}}</button>
						<button class="ui small primary approve button" form="pattern-disable-form-{{.ID}}" type="submit">{{ctx.Locale.Tr "secret_pattern.disable_submit"}}</button>
					</div>
				</article>
			</dialog>
			{{end}}
			<form id="pattern-delete-form-{{.ID}}" method="post" action="{{$p.Link}}/{{.ID}}/delete"></form>
			<dialog class="modal" id="pattern-delete-{{.ID}}" aria-labelledby="pattern-delete-title-{{.ID}}">
				<article>
					<header id="pattern-delete-title-{{.ID}}">{{ctx.Locale.Tr "secret_pattern.delete_title" .Name}}</header>
					<div class="content ui form">
						<p>{{if .Alerts}}{{ctx.Locale.TrPluralString .Alerts "secret_pattern.delete_text" (ctx.Locale.PrettyNumber .Alerts)}}{{else}}{{ctx.Locale.Tr "secret_pattern.delete_text_none"}}{{end}}</p>
						<div class="field">
							<label for="pattern-delete-name-{{.ID}}">{{ctx.Locale.Tr "secret_pattern.delete_type_name"}}</label>
							<input id="pattern-delete-name-{{.ID}}" name="confirm_name" form="pattern-delete-form-{{.ID}}" placeholder="{{.Name}}" autocomplete="off" data-confirm-name="{{.Name}}" data-confirm-button="#pattern-delete-ok-{{.ID}}">
						</div>
					</div>
					<div class="actions">
						<button type="button" class="ui small basic button" command="close" commandfor="pattern-delete-{{.ID}}">{{svg "octicon-x"}} {{ctx.Locale.Tr "cancel"}}</button>
						<button class="ui small red approve button" id="pattern-delete-ok-{{.ID}}" form="pattern-delete-form-{{.ID}}" type="submit">{{ctx.Locale.Tr "secret_pattern.delete_submit"}}</button>
					</div>
				</article>
			</dialog>
		{{end}}{{end}}
	{{end}}
</div>
