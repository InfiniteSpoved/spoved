{{/* The banner of a secret alert list while secret scanning is off: .SecretsSiteOff for the instance, .SecretsOrgOff for the organization */}}
<div class="ui warning message" id="secret-banner-off">
	<p>
		{{if .SecretsSiteOff}}{{ctx.Locale.Tr "repo.secrets.off.site"}}{{else}}{{ctx.Locale.Tr "repo.secrets.off.org" .Org.Name}}{{end}}
		{{ctx.Locale.Tr "repo.secrets.off.kept"}}
		{{if .SecretsSiteOff}}
			{{if .IsAdmin}}<a href="{{AppSubUrl}}/admin/config/secret-scanning">{{ctx.Locale.Tr "secret_search.off.turn_on_site"}}</a>{{else}}{{ctx.Locale.Tr "secret_search.off.ask_site_admin"}}{{end}}
		{{else if .IsOrganizationOwner}}<a href="{{.OrgLink}}/settings/code_security">{{ctx.Locale.Tr "repo.secrets.off.turn_on"}}</a>
		{{else}}{{ctx.Locale.Tr "secret_search.off.ask_owner"}}{{end}}
	</p>
</div>
