{{/* The access tokens section of a Keys and tokens page (organization, project, repository); see routers/web/shared/user/owned_token.go */}}
<h4 class="ui top attached header tw-mt-4" id="access-tokens">
	{{ctx.Locale.Tr "owned_token.title"}}
	<div class="ui right">
		<button class="ui primary tiny show-panel toggle button" data-panel="#add-access-token-panel">{{ctx.Locale.Tr "owned_token.add"}}</button>
	</div>
</h4>
<div class="ui attached segment">
	{{with .NewOwnedToken}}
		<div class="ui positive message" id="new-access-token">
			<p>{{if $.NewOwnedTokenRotated}}{{ctx.Locale.Tr "owned_token.rotated" .Name}}{{else}}{{ctx.Locale.Tr "owned_token.created" .Name}}{{end}}</p>
			<div class="tw-flex tw-items-center tw-gap-2 tw-my-2">
				<code class="tw-break-anywhere" id="new-access-token-value">{{.Token}}</code>
				<button class="ui basic label button" aria-label="{{ctx.Locale.Tr "copy"}}" data-clipboard-target="#new-access-token-value">{{svg "octicon-copy" 14}}</button>
			</div>
			<p id="new-access-token-summary">{{template "shared/owned_token_summary" (dict "ctxData" $ "Token" . "Repos" $.NewOwnedTokenRepos)}}</p>
			<p class="tw-mb-1">{{ctx.Locale.Tr "owned_token.usage_git"}}</p>
			<pre class="tw-my-1 tw-whitespace-pre-wrap tw-break-anywhere"><code>git clone {{$.OwnedTokenCloneURL}}</code></pre>
			<p class="tw-mb-1">{{ctx.Locale.Tr "owned_token.usage_api"}}</p>
			<pre class="tw-my-1 tw-whitespace-pre-wrap tw-break-anywhere"><code>curl -H "Authorization: token &lt;token&gt;" {{AppUrl}}api/v1/…</code></pre>
		</div>
	{{end}}
	<div class="{{if not .HasTokenError}}tw-hidden{{end}} tw-mb-4" id="add-access-token-panel">
		<form class="ui form" action="{{.OwnedTokensLink}}/new" method="post">
			<p>{{if eq .OwnedTokenLevel 1}}{{ctx.Locale.Tr "owned_token.desc.org"}}{{else if eq .OwnedTokenLevel 2}}{{ctx.Locale.Tr "owned_token.desc.project"}}{{else}}{{ctx.Locale.Tr "owned_token.desc.repo"}}{{end}}</p>
			{{if .TokenError}}<div class="ui negative message" id="access-token-error"><p>{{.TokenError}}</p></div>{{end}}
			<div class="required field {{if .Err_TokenName}}error{{end}}">
				<label for="access-token-name">{{ctx.Locale.Tr "owned_token.name"}}</label>
				<input id="access-token-name" name="token_name" value="{{.token_name}}" maxlength="255" required>
			</div>
			<div class="field">
				<label for="access-token-description">{{ctx.Locale.Tr "owned_token.description"}}</label>
				<input id="access-token-description" name="token_description" value="{{.token_description}}" maxlength="255">
			</div>
			<div class="grouped fields">
				<label>{{ctx.Locale.Tr "owned_token.permission"}}</label>
				{{range $mode := StringUtils.Split "read,write,admin" ","}}
					<div class="field">
						<div class="ui radio checkbox">
							<input id="access-token-permission-{{$mode}}" name="token_permission" type="radio" value="{{$mode}}" {{if eq $.token_permission $mode}}checked{{end}}>
							<label for="access-token-permission-{{$mode}}">
								{{if eq $mode "read"}}{{ctx.Locale.Tr "owned_token.permission.read"}}{{else if eq $mode "write"}}{{ctx.Locale.Tr "owned_token.permission.write"}}{{else}}{{ctx.Locale.Tr "owned_token.permission.admin"}}{{end}}
							</label>
						</div>
					</div>
				{{end}}
			</div>
			<div class="field {{if .Err_TokenScopes}}error{{end}}">
				<label>{{ctx.Locale.Tr "owned_token.scopes"}}</label>
				<p class="help">{{ctx.Locale.Tr "owned_token.scopes_help"}}</p>
				{{range .OwnedTokenScopeCategories}}
					<div class="field tw-pl-1 tw-pb-1 access-token-category">
						<label class="category-label" for="access-token-scope-{{.}}">{{.}}</label>
						<div class="gitea-select">
							<select class="ui selection access-token-select" name="token_scopes" id="access-token-scope-{{.}}">
								<option value="">{{ctx.Locale.Tr "settings.permission_no_access"}}</option>
								<option value="read:{{.}}" {{if SliceUtils.Contains $.token_scopes (printf "read:%s" .)}}selected{{end}}>{{ctx.Locale.Tr "settings.permission_read"}}</option>
								{{if ne . "organization"}}
									<option value="write:{{.}}" {{if SliceUtils.Contains $.token_scopes (printf "write:%s" .)}}selected{{end}}>{{ctx.Locale.Tr "settings.permission_write"}}</option>
								{{end}}
							</select>
						</div>
					</div>
				{{end}}
			</div>
			{{if eq .OwnedTokenLevel 1}}
				{{template "org/settings/deploy_key_scope" (dict "ctxData" $ "ID" "token" "All" .TokenScopeAll "RepoIDs" .TokenScopeRepoIDs)}}
			{{else}}
				<div class="field">
					<label>{{ctx.Locale.Tr "owned_token.coverage"}}</label>
					<p id="access-token-coverage">{{if .RepoGroup}}{{ctx.Locale.Tr "owned_token.covers.project" .RepoGroup.Name}}{{else}}{{ctx.Locale.Tr "owned_token.covers.repo"}}{{end}}</p>
				</div>
			{{end}}
			<div class="field {{if .Err_TokenExpiresAt}}error{{end}}">
				<label for="access-token-expires-at">{{ctx.Locale.Tr "credential.expires_at"}}</label>
				<input id="access-token-expires-at" name="token_expires_at" type="date" value="{{.token_expires_at}}"{{if .TokenExpiryMaxDate}} max="{{.TokenExpiryMaxDate}}"{{end}}{{if .TokenExpiryRequired}} required{{end}}>
				{{if .TokenExpiryMaxDate}}<span class="help">{{ctx.Locale.Tr "credential.expires_at.max_help" .TokenExpiryMaxDays}}</span>{{else if not .TokenExpiryRequired}}<span class="help">{{ctx.Locale.Tr "credential.expires_at.help"}}</span>{{end}}
			</div>
			<div class="field">
				<div class="ui checkbox">
					<input id="access-token-self-rotate" name="token_self_rotate" type="checkbox" {{if .token_self_rotate}}checked{{end}}>
					<label for="access-token-self-rotate">{{ctx.Locale.Tr "owned_token.self_rotate"}}</label>
					<small class="tw-pl-[26px]">{{ctx.Locale.Tr "owned_token.self_rotate_help"}}</small>
				</div>
			</div>
			<button class="ui primary button" id="access-token-create">{{ctx.Locale.Tr "owned_token.create"}}</button>
			<button class="ui hide-panel button" data-panel="#add-access-token-panel">{{ctx.Locale.Tr "cancel"}}</button>
		</form>
	</div>
	{{if .OwnedTokensFilter}}
		<form class="ui form tw-mb-4" action="{{.Link}}#access-tokens" method="get">
			<div class="ui small fluid action input">
				<input name="q" value="{{.OwnedTokensKeyword}}" placeholder="{{ctx.Locale.Tr "owned_token.filter"}}" aria-label="{{ctx.Locale.Tr "owned_token.filter"}}">
				<button class="ui small icon button" aria-label="{{ctx.Locale.Tr "search.search"}}">{{svg "octicon-search"}}</button>
			</div>
		</form>
	{{end}}
	{{if .OwnedTokens}}
		<div class="flex-list" id="access-token-list">
			{{range .OwnedTokens}}
				{{$t := .Token}}
				<div class="flex-item">
					<div class="flex-item-leading">
						<span class="text {{if $t.HasRecentActivity}}green{{end}}" {{if $t.HasRecentActivity}}data-tooltip-content="{{ctx.Locale.Tr "settings.token_state_desc"}}"{{end}}>{{svg "fontawesome-send" 32}}</span>
					</div>
					<div class="flex-item-main">
						<div class="flex-item-title">
							<span {{if $t.IsExpired}}class="tw-text-text-light-3"{{end}}>{{$t.Name}}</span>
							<span class="ui tiny basic label">{{if eq $t.Mode 1}}{{ctx.Locale.Tr "owned_token.permission.read_short"}}{{else if eq $t.Mode 2}}{{ctx.Locale.Tr "owned_token.permission.write_short"}}{{else}}{{ctx.Locale.Tr "owned_token.permission.admin_short"}}{{end}}</span>
							{{if $t.IsExpired}}<span class="ui tiny red label">{{ctx.Locale.Tr "owned_token.expired"}}</span>{{else if .ExpiresSoon}}<span class="ui tiny yellow label">{{ctx.Locale.Tr "owned_token.expires_soon"}}</span>{{end}}
						</div>
						{{if $t.Description}}<div class="flex-item-body">{{$t.Description}}</div>{{end}}
						<div class="flex-item-body">{{ctx.Locale.Tr "owned_token.scopes"}}: {{StringUtils.Join $t.Scope.StringSlice ", "}}{{if $t.SelfRotate}} · {{ctx.Locale.Tr "owned_token.self_rotate_short"}}{{end}}</div>
						<div class="flex-item-body">
							{{ctx.Locale.Tr "owned_token.coverage"}}:
							{{if eq $.OwnedTokenLevel 1}}{{if $t.ResourceAllRepos}}{{ctx.Locale.Tr "owned_token.covers.org_all"}}{{else}}{{range $i, $r := .Repos}}{{if $i}}, {{end}}{{$r.FullName}}{{end}}{{end}}{{else if $.RepoGroup}}{{ctx.Locale.Tr "owned_token.covers.project" $.RepoGroup.Name}}{{else}}{{ctx.Locale.Tr "owned_token.covers.repo"}}{{end}}
						</div>
						<div class="flex-item-body">
							<p>{{ctx.Locale.Tr "owned_token.created_by" .CreatedBy.GetDisplayName (DateUtils.AbsoluteShort $t.CreatedUnix)}} — {{svg "octicon-info"}} {{if $t.HasUsed}}{{ctx.Locale.Tr "settings.last_used"}} <span {{if $t.HasRecentActivity}}class="text green"{{end}}>{{DateUtils.AbsoluteShort $t.UpdatedUnix}}</span>{{if $t.LastUsedIP}} ({{$t.LastUsedIP}}){{end}}{{else}}{{ctx.Locale.Tr "settings.no_activity"}}{{end}}{{template "shared/expiry_label" $t}}</p>
						</div>
						{{if $t.RotatedUnix}}
							<div class="flex-item-body last-rotated">{{if .RotatedSelf}}{{ctx.Locale.Tr "owned_token.rotated_self" (DateUtils.AbsoluteShort $t.RotatedUnix)}}{{else}}{{ctx.Locale.Tr "owned_token.rotated_by" .RotatedBy.GetDisplayName (DateUtils.AbsoluteShort $t.RotatedUnix)}}{{end}}</div>
						{{end}}
					</div>
					<div class="flex-item-trailing">
						<button class="ui primary tiny button show-modal" data-modal="#rotate-access-token" data-modal-token-id="{{$t.ID}}" data-modal-name="{{$t.Name}}"
							data-modal-rotate-expiry="{{if .RotateExpires}}{{ctx.Locale.TrString "owned_token.rotate_expiry" .RotateExpires}}{{else}}{{ctx.Locale.TrString "owned_token.rotate_no_expiry"}}{{end}}">
							{{svg "octicon-sync" 16 "tw-mr-1"}}{{ctx.Locale.Tr "owned_token.rotate"}}
						</button>
						<button class="ui red tiny button delete-button" data-modal-id="revoke-access-token" data-url="{{$.OwnedTokensLink}}/delete" data-id="{{$t.ID}}" data-name="{{$t.Name}}">
							{{svg "octicon-trash" 16 "tw-mr-1"}}{{ctx.Locale.Tr "owned_token.revoke"}}
						</button>
					</div>
				</div>
			{{end}}
		</div>
		{{template "base/paginate" .}}
	{{else if .OwnedTokensKeyword}}
		<p>{{ctx.Locale.Tr "owned_token.no_match"}}</p>
	{{else}}
		<div class="tw-text-center tw-py-4" id="access-tokens-empty">
			<p>{{ctx.Locale.Tr "owned_token.empty"}}</p>
			<button class="ui primary tiny show-panel button" data-panel="#add-access-token-panel">{{ctx.Locale.Tr "owned_token.add"}}</button>
		</div>
	{{end}}
</div>

<div class="ui g-modal-confirm delete modal" id="revoke-access-token">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "owned_token.revoke_title"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "owned_token.revoke_desc" (`<strong class="name"></strong>`|TrustHTML)}}</p>
	</div>
	{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm" "ModalButtonOkText" (ctx.Locale.Tr "owned_token.revoke"))}}
</div>

<dialog class="modal" id="rotate-access-token">
	<article>
		<header>{{svg "octicon-sync"}} {{ctx.Locale.Tr "owned_token.rotate_title"}}</header>
		<form class="ui form" action="{{.OwnedTokensLink}}/rotate" method="post">
			<div class="content">
				<input type="hidden" name="id" class="token-id">
				<p>{{ctx.Locale.Tr "owned_token.rotate_desc" (`<strong class="name"></strong>`|TrustHTML)}} <span class="rotate-expiry"></span></p>
			</div>
			{{template "base/modal_actions_confirm" (dict "ModalButtonTypes" "confirm" "ModalButtonOkText" (ctx.Locale.Tr "owned_token.rotate"))}}
		</form>
	</article>
</dialog>
