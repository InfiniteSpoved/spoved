{{/* Rows: []*api.AccessRow; ShowRepo: show the repository instead of the identity */}}
<table class="ui very basic striped table unstackable access-report">
	<thead>
		<tr>
			<th>{{if .ShowRepo}}{{ctx.Locale.Tr "access_report.repository"}}{{else}}{{ctx.Locale.Tr "access_report.who"}}{{end}}</th>
			<th>{{ctx.Locale.Tr "access_report.access"}}</th>
			<th>{{ctx.Locale.Tr "access_report.units"}}</th>
			<th>{{ctx.Locale.Tr "access_report.through"}}</th>
		</tr>
	</thead>
	<tbody>
		{{range .Rows}}
			<tr data-type="{{.Type}}"{{if .User}} data-user="{{.User.UserName}}"{{else if .DeployKey}} data-key="{{.DeployKey.Name}}"{{else if .AccessToken}} data-token="{{.AccessToken.Name}}"{{else if .Team}} data-team="{{.Team.Name}}"{{end}} data-repo="{{.Repository}}">
				<td>
					{{if $.ShowRepo}}
						<a href="{{AppSubUrl}}/{{.Repository}}">{{.Repository}}</a>
					{{else if .User}}
						<a href="{{.User.HTMLURL}}">{{.User.UserName}}</a>{{if eq .Type "bot"}} <span class="ui label">{{ctx.Locale.Tr "access_report.type.bot"}}</span>{{end}}
					{{else if .DeployKey}}
						{{svg "octicon-key"}} {{.DeployKey.Name}} <span class="text grey">{{.DeployKey.Fingerprint}}</span>
					{{else if .AccessToken}}
						{{svg "fontawesome-send"}} {{.AccessToken.Name}} <span class="ui label">{{ctx.Locale.Tr "access_report.type.bot"}}</span>
						<div class="text grey">{{ctx.Locale.Tr "owned_token.scopes"}}: {{StringUtils.Join .AccessToken.Scopes ", "}}</div>
					{{else if .Team}}
						{{ctx.Locale.Tr "access_report.who.team" .Team.Name .Team.NumMembers}}
					{{else}}
						<em>{{ctx.Locale.Tr (print "access_report.who." .Type)}}</em>
					{{end}}
				</td>
				<td>{{if .Access}}{{ctx.Locale.Tr (print "access_report.mode." .Access)}}{{end}}</td>
				<td>{{range $key, $mode := .Units}}<span class="ui basic label">{{ctx.Locale.Tr $key}}: {{ctx.Locale.Tr (print "access_report.mode." $mode)}}</span>{{end}}</td>
				<td>
					{{range .Paths}}
						<div{{if not .Applied}} class="text grey"{{end}}>
							{{if .Team}}{{ctx.Locale.Tr (print "access_report.kind." .Kind) .Team}}{{else}}{{ctx.Locale.Tr (print "access_report.kind." .Kind)}}{{end}}{{if and .Access (ne .Kind "instance_roles")}}: {{ctx.Locale.Tr (print "access_report.mode." .Access)}}{{end}}
							{{range .UserGroups}} ← {{ctx.Locale.Tr "access_report.via_group" .Name}}{{if .LoginSource}} ← {{ctx.Locale.Tr "access_report.synced_by" .LoginSource}}{{end}}{{end}}
							{{if not .Applied}}({{ctx.Locale.Tr "access_report.not_applied"}}){{end}}
						</div>
					{{end}}
				</td>
			</tr>
		{{end}}
	</tbody>
</table>
