{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content organization teams">
	{{template "org/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		<div class="ui stackable grid">
			{{template "org/team/sidebar" .}}
			<div class="ui ten wide column">
				{{template "org/team/navbar" .}}
				{{if .IsOrganizationOwner}}
					<div class="ui attached segment">
						<form class="ui form ignore-dirty tw-flex tw-flex-wrap tw-gap-2" action="{{$.OrgLink}}/teams/{{$.Team.LowerName | PathEscape}}/action/add" method="post">
							<input type="hidden" name="uid" value="{{.SignedUser.ID}}">
							<div id="search-user-box" class="ui search tw-mr-2"{{if .IsEmailInviteEnabled}} data-allow-email="true" data-allow-email-description="{{ctx.Locale.Tr "org.teams.invite_team_member" $.Team.Name}}"{{end}}>
								<div class="ui input">
									<input class="prompt" name="uname" placeholder="{{ctx.Locale.Tr "search.user_kind"}}" autocomplete="off" required>
								</div>
							</div>
							<button class="ui primary button">
								{{if $.AddMembersByInvitations}}
									{{ctx.Locale.Tr "members.invite_team_member"}}
								{{else}}
									{{ctx.Locale.Tr "org.teams.add_team_member"}}
								{{end}}
							</button>
						</form>
					</div>
				{{end}}
				<div class="ui attached segment">
					<div class="flex-list">
						{{range $.Memberships}}
							<div class="flex-item tw-items-center">
								<div class="flex-item-leading">
									<a href="{{.User.HomeLink}}">{{ctx.AvatarUtils.Avatar .User 32}}</a>
								</div>
								<div class="flex-item-main">
									<div class="flex-item-title">
										{{template "shared/user/name" .User}}
									</div>
									{{template "org/team/membership_origin" dict "Membership" . "UserGroups" (index $.MemberUserGroups .UID)}}
								</div>
								<div class="flex-item-trailing">
									{{if and $.IsOrganizationOwner (not .IsMembershipAddedByUserGroup) (not (and ($.Team.IsOwnerTeam) (eq (len $.Team.Members) 1)))}}
										<form>
											<button class="ui danger button delete-button" data-modal-id="remove-team-member"
												data-url="{{$.OrgLink}}/teams/{{$.Team.LowerName | PathEscape}}/action/remove" data-datauid="{{.User.ID}}"
												data-name="{{.User.DisplayName}}"
												data-data-team-name="{{$.Team.Name}}">{{ctx.Locale.Tr "org.members.remove"}}</button>
										</form>
									{{end}}
								</div>
							</div>
						{{else}}
							<div class="flex-item">
								<span class="text grey tw-italic">{{ctx.Locale.Tr "org.teams.members.none"}}</span>
							</div>
						{{end}}
					</div>
					{{template "base/paginate" .}}
				</div>
				<h4 class="ui top attached header" id="team-user-groups">{{ctx.Locale.Tr "org.teams.user_groups"}}</h4>
				{{if .IsOrganizationOwner}}
					<div class="ui attached segment">
						<form class="ui form ignore-dirty tw-flex tw-flex-wrap tw-gap-2" action="{{$.OrgLink}}/teams/{{$.Team.LowerName | PathEscape}}/action/group/link" method="post">
							<div id="search-user-group-box" class="ui search tw-mr-2" data-url="{{$.OrgLink}}/teams/{{$.Team.LowerName | PathEscape}}/groups/search">
								<div class="ui input">
									<input class="prompt" name="group_name" placeholder="{{ctx.Locale.Tr "org.teams.user_groups.name_placeholder"}}" aria-label="{{ctx.Locale.Tr "org.teams.user_groups.name_placeholder"}}" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" required>
								</div>
							</div>
							<button class="ui primary button">{{ctx.Locale.Tr "org.teams.user_groups.link"}}</button>
						</form>
						{{if $.AddMembersByInvitations}}
							<div class="text grey tw-mt-2">{{ctx.Locale.Tr "org.teams.user_groups.no_invitation"}}</div>
						{{end}}
					</div>
				{{end}}
				<div class="ui attached segment">
					<div class="flex-list">
						{{range $.UserGroups}}
							<div class="flex-item tw-items-center">
								<div class="flex-item-leading">{{svg "octicon-people" 32}}</div>
								<div class="flex-item-main">
									<div class="flex-item-title">
										{{if $.IsAdmin}}<a href="{{AppSubUrl}}/admin/groups/{{.ID}}">{{.Name}}</a>{{else}}{{.Name}}{{end}}
										<span class="text grey">· {{ctx.Locale.TrPluralString .NumMembers "org.teams.user_groups.num_members" .NumMembers}}</span>
										{{if index $.ManagedUserGroups .ID}}<span class="ui mini basic label">{{ctx.Locale.Tr "org.teams.user_groups.managed_by_policy"}}</span>{{end}}
									</div>
									{{if .Description}}<div class="flex-item-body">{{.Description}}</div>{{end}}
								</div>
								{{if and $.IsOrganizationOwner (not (index $.ManagedUserGroups .ID))}}
									<div class="flex-item-trailing">
										<form action="{{$.OrgLink}}/teams/{{$.Team.LowerName | PathEscape}}/action/group/unlink" method="post">
											<input type="hidden" name="group_id" value="{{.ID}}">
											<button class="ui red button">{{ctx.Locale.Tr "org.teams.user_groups.unlink"}}</button>
										</form>
									</div>
								{{end}}
							</div>
						{{else}}
							<div class="flex-item">
								<span class="text grey tw-italic">{{ctx.Locale.Tr "org.teams.user_groups.none"}}</span>
							</div>
						{{end}}
					</div>
				</div>
				{{if and .PendingInvites $.IsOrganizationOwner}}
				<h4 class="ui top attached header">{{ctx.Locale.Tr "org.teams.invite_team_member.list"}}</h4>
				<div class="ui attached segment">
					{{template "org/team/invite_list" (dict "Invites" .PendingInvites "OrgLink" .OrgLink "Team" .Team)}}
				</div>
				{{end}}
				{{if and .ExpiredInvites $.IsOrganizationOwner}}
				<h4 class="ui top attached header">{{ctx.Locale.Tr "org.teams.invite_team_member.expired_list"}}</h4>
				<div class="ui attached segment">
					{{template "org/team/invite_list" (dict "Invites" .ExpiredInvites "OrgLink" .OrgLink "Team" .Team)}}
				</div>
				{{end}}
			</div>
		</div>
	</div>
</div>
<div class="ui g-modal-confirm delete modal" id="remove-team-member">
	<div class="header">
		{{ctx.Locale.Tr "org.members.remove"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "org.members.remove.detail" (`<span class="name"></span>`|TrustHTML) (`<span class="dataTeamName"></span>`|TrustHTML)}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{template "base/footer" .}}
