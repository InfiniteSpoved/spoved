{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content organization settings repo-group">
	{{template "org/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		<h2 class="tw-break-anywhere">
			<a class="muted" href="{{.Org.HomeLink}}">{{.Org.Name}}</a> / <a class="muted" href="{{.RepoGroupLink}}">{{.RepoGroup.Name}}</a>
		</h2>
		<form class="ui form" action="{{.RepoGroupLink}}/-/settings" method="post">
			<h4 class="ui top attached header">{{ctx.Locale.Tr "repo_group.settings"}}</h4>
			<div class="ui attached segment">
				{{template "org/repo_group/fields" .}}
				<button class="ui primary button">{{ctx.Locale.Tr "repo_group.settings.update"}}</button>
			</div>
		</form>

		<h4 class="ui top attached header tw-mt-4">{{ctx.Locale.Tr "repo_group.teams"}}</h4>
		<div class="ui attached segment">
			<p>{{ctx.Locale.Tr "repo_group.teams.desc"}}</p>
			<div class="flex-list">
				{{range .LinkedTeams}}
					<div class="flex-item flex-item-center">
						<div class="flex-item-main">
							<div class="flex-item-title tw-break-anywhere"><a href="{{$.Org.OrganisationLink}}/teams/{{.LowerName | PathEscape}}">{{.Name}}</a></div>
						</div>
						<div class="flex-item-trailing">
							<button class="ui red tiny button delete-button" data-url="{{$.RepoGroupLink}}/-/settings/teams/unlink" data-id="{{.ID}}" data-modal-id="unlink-team">
								{{ctx.Locale.Tr "repo_group.teams.unlink"}}
							</button>
						</div>
					</div>
				{{else}}
					<div class="flex-item">{{ctx.Locale.Tr "repo_group.teams.none"}}</div>
				{{end}}
			</div>
			{{if .OtherTeams}}
				<form class="ui form ignore-dirty tw-flex tw-flex-wrap tw-gap-2 tw-mt-4" action="{{.RepoGroupLink}}/-/settings/teams/link" method="post">
					<select name="team_id" aria-label="{{ctx.Locale.Tr "repo_group.teams.select"}}" required>
						<option value="">{{ctx.Locale.Tr "repo_group.teams.select"}}</option>
						{{range .OtherTeams}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
					</select>
					<button class="ui primary button">{{ctx.Locale.Tr "repo_group.teams.link"}}</button>
				</form>
			{{end}}
		</div>

		<h4 class="ui top attached header tw-mt-4">
			{{ctx.Locale.Tr "repo_group.branches"}}
			<div class="ui right">
				<a class="ui primary tiny button" href="{{.RepoGroupLink}}/-/settings/branches/edit">{{ctx.Locale.Tr "repo.settings.branches.add_new_rule"}}</a>
			</div>
		</h4>
		<div class="ui attached segment">
			<p>{{ctx.Locale.Tr "repo_group.branches.desc"}}</p>
			<div class="flex-list">
				{{range .ProtectedBranches}}
					<div class="flex-item flex-item-center">
						<div class="flex-item-main">
							<div class="flex-item-title"><div class="ui basic primary label">{{.RuleName}}</div></div>
						</div>
						<div class="flex-item-trailing">
							<a class="ui tiny button" href="{{$.RepoGroupLink}}/-/settings/branches/edit?rule_name={{.RuleName}}">{{ctx.Locale.Tr "repo.settings.edit_protected_branch"}}</a>
							<button class="ui red tiny button delete-button" data-url="{{$.RepoGroupLink}}/-/settings/branches/{{.ID}}/delete" data-id="{{.ID}}" data-modal-id="delete-protected-branch">
								{{ctx.Locale.Tr "repo.settings.protected_branch.delete_rule"}}
							</button>
						</div>
					</div>
				{{else}}
					<div class="flex-item">{{ctx.Locale.Tr "repo.settings.no_protected_branch"}}</div>
				{{end}}
			</div>
		</div>

		{{template "shared/delete_merged_branches" .}}

		<h4 class="ui top attached header tw-mt-4">
			{{ctx.Locale.Tr "repo_group.deploy_keys"}}
			<div class="ui right">
				<a class="ui primary tiny button" href="{{.RepoGroupLink}}/-/settings/keys">{{ctx.Locale.Tr "repo_group.deploy_keys"}}</a>
			</div>
		</h4>
		<div class="ui attached segment">
			<p>{{ctx.Locale.Tr "repo_group.deploy_keys_desc"}}</p>
		</div>

		<h4 class="ui top attached header tw-mt-4">
			{{ctx.Locale.Tr "repo_group.hooks"}}
			<div class="ui right">
				<a class="ui primary tiny button" href="{{.RepoGroupLink}}/-/settings/hooks">{{ctx.Locale.Tr "repo_group.hooks"}}</a>
			</div>
		</h4>
		<div class="ui attached segment">
			<p>{{ctx.Locale.Tr "repo_group.hooks_desc"}}</p>
		</div>

		{{if .EnableActions}}
		<h4 class="ui top attached header tw-mt-4">
			{{ctx.Locale.Tr "repo_group.secrets"}} / {{ctx.Locale.Tr "repo_group.variables"}}
			<div class="ui right">
				<a class="ui primary tiny button" href="{{.RepoGroupLink}}/-/settings/secrets">{{ctx.Locale.Tr "repo_group.secrets"}}</a>
				<a class="ui primary tiny button" href="{{.RepoGroupLink}}/-/settings/variables">{{ctx.Locale.Tr "repo_group.variables"}}</a>
			</div>
		</h4>
		<div class="ui attached segment">
			<p>{{ctx.Locale.Tr "repo_group.actions_desc"}}</p>
		</div>
		{{end}}

		<h4 class="ui top attached error header tw-mt-4">{{ctx.Locale.Tr "repo_group.delete"}}</h4>
		<div class="ui attached error segment">
			<p>{{ctx.Locale.Tr "repo_group.delete.desc"}}</p>
			<form class="ui form ignore-dirty" action="{{.RepoGroupLink}}/-/settings/delete" method="post">
				<div class="required field">
					<label for="confirm_name">{{ctx.Locale.Tr "repo_group.delete.confirm" (print .Org.Name "/" .RepoGroup.Name)}}</label>
					<input id="confirm_name" name="confirm_name" required autocomplete="off">
				</div>
				<button class="ui red button">{{ctx.Locale.Tr "repo_group.delete"}}</button>
			</form>
		</div>
	</div>
</div>
<div class="ui g-modal-confirm delete modal" id="delete-protected-branch">
	<div class="header">{{svg "octicon-trash"}} {{ctx.Locale.Tr "repo.settings.protected_branch_deletion"}}</div>
	<div class="content"><p>{{ctx.Locale.Tr "repo.settings.protected_branch_deletion_desc"}}</p></div>
	{{template "base/modal_actions_confirm" .}}
</div>
<div class="ui g-modal-confirm delete modal" id="unlink-team">
	<div class="header">{{ctx.Locale.Tr "repo_group.teams.unlink"}}</div>
	<div class="content"><p>{{ctx.Locale.Tr "repo_group.teams.unlink_desc"}}</p></div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{template "base/footer" .}}
