<div class="required field {{if .Err_Name}}error{{end}}">
	<label for="name">{{ctx.Locale.Tr "repo_group.name"}}</label>
	<input id="name" name="name" value="{{.name}}" required maxlength="100" autofocus autocorrect="off" autocapitalize="none" spellcheck="false">
	<span class="help">{{ctx.Locale.Tr "repo_group.name_helper"}}</span>
</div>
<div class="field {{if .Err_Description}}error{{end}}">
	<label for="description">{{ctx.Locale.Tr "repo_group.description"}}</label>
	<textarea id="description" name="description" rows="2" maxlength="2048">{{.description}}</textarea>
</div>
