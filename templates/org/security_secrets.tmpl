{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content organization security-search">
	{{template "org/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		<h2 class="ui header">{{ctx.Locale.Tr "security_search.title"}}</h2>
		{{template "org/security_tabs" (dict "Ctx" . "Active" "secrets")}}
		{{if or .SecretsSiteOff .SecretsOrgOff}}
			{{template "shared/secret_alerts_off" .}}
		{{else}}
			{{template "shared/secret_alerts" .}}
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
