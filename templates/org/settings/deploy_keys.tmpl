{{template "org/settings/layout_head" (dict "ctxData" . "pageClass" "organization settings deploy-keys")}}
<div class="org-setting-content">
	<h4 class="ui top attached header">
		{{ctx.Locale.Tr "org.settings.deploy_keys"}}
		<div class="ui right">
		{{if not .DisableSSH}}
			<button class="ui primary tiny show-panel toggle button" data-panel="#add-deploy-key-panel">{{ctx.Locale.Tr "repo.settings.add_deploy_key"}}</button>
		{{else}}
			<button class="ui primary tiny button disabled">{{ctx.Locale.Tr "settings.ssh_disabled"}}</button>
		{{end}}
		</div>
	</h4>
	<div class="ui attached segment">
		<div class="{{if not .HasError}}tw-hidden{{end}} tw-mb-4" id="add-deploy-key-panel">
			<form class="ui form" action="{{.Link}}" method="post">
				<div class="field">
					{{ctx.Locale.Tr "org.settings.deploy_keys_desc"}}
				</div>
				<div class="field {{if .Err_Title}}error{{end}}">
					<label for="ssh-key-title">{{ctx.Locale.Tr "repo.settings.title"}}</label>
					<input id="ssh-key-title" name="title" value="{{.title}}" maxlength="50" autofocus required>
				</div>
				<div class="field {{if .Err_Content}}error{{end}}">
					<label for="ssh-key-content">{{ctx.Locale.Tr "repo.settings.deploy_key_content"}}</label>
					<textarea id="ssh-key-content" name="content" placeholder="{{ctx.Locale.Tr "settings.key_content_ssh_placeholder"}}" required>{{.content}}</textarea>
				</div>
				<div class="field">
					<div class="ui checkbox">
						<input id="ssh-key-is-writable" name="is_writable" type="checkbox" value="1">
						<label for="ssh-key-is-writable">{{ctx.Locale.Tr "repo.settings.is_writable"}}</label>
						<small class="tw-pl-[26px]">{{ctx.Locale.Tr "repo.settings.is_writable_info"}}</small>
					</div>
				</div>
				{{template "org/settings/deploy_key_scope" (dict "ctxData" $ "ID" "new" "All" true "RepoIDs" "")}}
				{{template "shared/expiry_input" .}}
				<button class="ui primary button">{{ctx.Locale.Tr "repo.settings.add_deploy_key"}}</button>
				<button class="ui hide-panel button" data-panel="#add-deploy-key-panel">{{ctx.Locale.Tr "cancel"}}</button>
			</form>
		</div>
		{{if .DeployKeys}}
			<div class="flex-list">
				{{range .DeployKeys}}
					{{$key := .Key}}
					<div class="flex-item">
						<div class="flex-item-leading">
							<span class="text {{if $key.HasRecentActivity}}green{{end}}" {{if $key.HasRecentActivity}}data-tooltip-content="{{ctx.Locale.Tr "settings.key_state_desc"}}"{{end}}>{{svg "octicon-key" 32}}</span>
						</div>
						<div class="flex-item-main">
							<div class="flex-item-title">{{$key.Name}}</div>
							<div class="flex-item-body">{{$key.Fingerprint}}</div>
							<div class="flex-item-body">
								<p>{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort $key.CreatedUnix)}} — {{svg "octicon-info"}} {{if $key.HasUsed}}{{ctx.Locale.Tr "settings.last_used"}} <span {{if $key.HasRecentActivity}}class="text green"{{end}}>{{DateUtils.AbsoluteShort $key.UpdatedUnix}}</span>{{else}}{{ctx.Locale.Tr "settings.no_activity"}}{{end}}{{template "shared/expiry_label" $key}} - <span>{{ctx.Locale.Tr "settings.can_read_info"}}{{if not $key.IsReadOnly}} / {{ctx.Locale.Tr "settings.can_write_info"}}{{end}}</span></p>
							</div>
							<div class="flex-item-body">
								{{ctx.Locale.Tr "org.settings.deploy_key_scope"}}:
								{{if $key.IncludesAllRepos}}{{ctx.Locale.Tr "org.settings.deploy_key_covers_all"}}{{else}}{{range $i, $r := .Repos}}{{if $i}}, {{end}}{{$r.Name}}{{end}}{{end}}
							</div>
							<details>
								<summary>{{ctx.Locale.Tr "org.settings.deploy_key_save_repos"}}</summary>
								<form class="ui form" action="{{$.Link}}/{{$key.ID}}/repos" method="post">
									{{template "org/settings/deploy_key_scope" (dict "ctxData" $ "ID" $key.ID "All" $key.IncludesAllRepos "RepoIDs" .RepoIDs)}}
									<button class="ui primary tiny button">{{ctx.Locale.Tr "org.settings.deploy_key_save_repos"}}</button>
								</form>
							</details>
						</div>
						<div class="flex-item-trailing">
							<button class="ui red tiny button delete-button" data-url="{{$.Link}}/delete" data-id="{{$key.ID}}" data-modal-id="delete-deploy-key">
								{{ctx.Locale.Tr "settings.delete_key"}}
							</button>
						</div>
					</div>
				{{end}}
			</div>
		{{else}}
			{{ctx.Locale.Tr "repo.settings.no_deploy_keys"}}
		{{end}}
	</div>
</div>

<div class="ui g-modal-confirm delete modal" id="delete-deploy-key">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "repo.settings.deploy_key_deletion"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "org.settings.deploy_key_deletion_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>
{{template "org/settings/layout_footer" .}}
