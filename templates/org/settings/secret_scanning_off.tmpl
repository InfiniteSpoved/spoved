{{template "org/settings/layout_head" (dict "ctxData" . "pageClass" "organization settings code-security secret-scanning-off")}}
<div class="org-setting-content">
	<h4 class="ui top attached header">
		{{ctx.Locale.Tr "org.settings.secret_scanning.off_list"}}
	</h4>
	<div class="ui attached segment">
		{{if .SecretOrgLocked}}<div class="ui info message" id="secret-scanning-off-locked">{{ctx.Locale.Tr "org.settings.secret_scanning.off_list_locked"}}</div>
		{{else if not .SecretOrgOn}}<div class="ui info message" id="secret-scanning-off-org-off">{{ctx.Locale.Tr "org.settings.secret_scanning.off_list_org_off"}}</div>{{end}}
		<p class="help">{{ctx.Locale.Tr "org.settings.secret_scanning.off_list_help"}} <a href="{{.OrgLink}}/settings/code_security">{{ctx.Locale.Tr "org.settings.secret_scanning.back"}}</a></p>
	</div>
	{{if .Rows}}
	<div class="ui attached segment">
		<div class="flex-list" id="secret-scanning-off-list">
			{{range .Rows}}
			<div class="flex-item">
				<div class="flex-item-main">
					<a class="flex-item-title" href="{{.Link}}">{{.FullName}}</a>
					<div class="flex-item-body">{{if .By}}{{ctx.Locale.Tr "org.settings.secret_scanning.off_row" .By (DateUtils.AbsoluteShort .At)}}{{else}}{{ctx.Locale.Tr "org.settings.secret_scanning.off_row_unknown"}}{{end}}</div>
				</div>
			</div>
			{{end}}
		</div>
	</div>
	{{template "base/paginate" .}}
	{{else}}
	<div class="ui attached segment"><p class="help" id="secret-scanning-off-empty">{{ctx.Locale.Tr "org.settings.secret_scanning.off_list_empty"}}</p></div>
	{{end}}
</div>
{{template "org/settings/layout_footer" .}}
