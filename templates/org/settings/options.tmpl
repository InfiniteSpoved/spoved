{{template "org/settings/layout_head" (dict "ctxData" . "pageClass" "organization settings options")}}
			<div class="org-setting-content">
				<h4 class="ui top attached header">
					{{ctx.Locale.Tr "org.settings.options"}}
				</h4>
				<div class="ui attached segment">
					<form class="ui form" action="{{.Link}}" method="post">
						<label {{if .Err_Name}}class="field error"{{end}}>
							{{ctx.Locale.Tr "org.org_name_holder"}}
							<input id="org_name" name="name" value="{{.Org.Name}}" data-org-name="{{.Org.Name}}" autofocus required maxlength="40">
							<span class="help">
								{{ctx.Locale.Tr "org.settings.change_orgname_prompt"}}
								{{if gt .CooldownPeriod 0}}
									{{ctx.Locale.TrN .CooldownPeriod "org.settings.change_orgname_redirect_prompt.with_cooldown.one" "org.settings.change_orgname_redirect_prompt.with_cooldown.few" .CooldownPeriod}}</span>
								{{else}}
									{{ctx.Locale.Tr "org.settings.change_orgname_redirect_prompt"}}
								{{end}}
							</span>
						</label>
						<div class="field {{if .Err_FullName}}error{{end}}">
							<label for="full_name">{{ctx.Locale.Tr "org.org_full_name_holder"}}</label>
							<input id="full_name" name="full_name" value="{{.Org.FullName}}" maxlength="100">
						</div>
						<div class="field {{if .Err_Email}}error{{end}}">
							<label for="email">{{ctx.Locale.Tr "org.settings.email"}}</label>
							<input id="email" name="email" type="email" value="{{.Org.Email}}" maxlength="255">
						</div>
						<div class="field {{if .Err_Description}}error{{end}}">
							<label for="description">{{ctx.Locale.Tr "org.org_desc"}}</label>
							<textarea id="description" name="description" rows="2" maxlength="255">{{.Org.Description}}</textarea>
						</div>
						<div class="field {{if .Err_Website}}error{{end}}">
							<label for="website">{{ctx.Locale.Tr "org.settings.website"}}</label>
							<input id="website" name="website" type="url" value="{{.Org.Website}}" maxlength="255" pattern="{{.ValidSiteURLPattern}}">
							<span class="help">{{ctx.Locale.Tr "form.website.valid_url_schemes" (StringUtils.Join .ValidSiteURLSchemes ", ")}}</span>
						</div>
						<div class="field">
							<label for="location">{{ctx.Locale.Tr "org.settings.location"}}</label>
							<input id="location" name="location"  value="{{.Org.Location}}" maxlength="50">
						</div>

						<div class="divider"></div>
						<div class="field" id="visibility_box">
							<label for="visibility">{{ctx.Locale.Tr "org.settings.visibility"}}</label>
							<div class="field">
								<div class="ui radio checkbox">
									<input class="enable-system-radio" name="visibility" type="radio" value="0" {{if eq .CurrentVisibility 0}}checked{{end}}>
									<label>{{ctx.Locale.Tr "org.settings.visibility.public"}}</label>
								</div>
							</div>
							<div class="field">
								<div class="ui radio checkbox">
									<input class="enable-system-radio" name="visibility" type="radio" value="1" {{if eq .CurrentVisibility 1}}checked{{end}}>
									<label>{{ctx.Locale.Tr "org.settings.visibility.limited"}}</label>
								</div>
							</div>
							<div class="field">
								<div class="ui radio checkbox">
									<input class="enable-system-radio" name="visibility" type="radio" value="2" {{if eq .CurrentVisibility 2}}checked{{end}}>
									<label>{{ctx.Locale.Tr "org.settings.visibility.private"}}</label>
								</div>
							</div>
						</div>

						<div class="field" id="repo_policies_box">
							<label>{{ctx.Locale.Tr "org.settings.repo_policies"}}</label>
							<p class="help">{{ctx.Locale.Tr "org.settings.repo_policies_desc"}}</p>
							<div class="field">
								<div class="ui checkbox">
									<input type="checkbox" name="restrict_repo_visibility_change" {{if .EffectiveRestrictVisibility}}checked{{end}} {{if .SiteRestrictVisibility}}disabled{{end}}>
									<label>{{ctx.Locale.Tr "org.settings.restrict_repo_visibility_change"}}</label>
								</div>
								{{if .SiteRestrictVisibility}}<p class="help site-policy-floor">{{ctx.Locale.Tr "org.settings.site_policy_floor"}}</p>{{end}}
							</div>
							<div class="field">
								<label for="private_fork_policy">{{ctx.Locale.Tr "org.settings.private_fork_policy"}}</label>
								<select id="private_fork_policy" name="private_fork_policy">
									<option value="0" {{if eq .EffectiveForkPolicy 0}}selected{{end}} {{if lt 0 .SiteForkPolicy}}disabled{{end}}>{{ctx.Locale.Tr "org.settings.private_fork_policy.all"}}</option>
									<option value="1" {{if eq .EffectiveForkPolicy 1}}selected{{end}} {{if lt 1 .SiteForkPolicy}}disabled{{end}}>{{ctx.Locale.Tr "org.settings.private_fork_policy.org"}}</option>
									<option value="2" {{if eq .EffectiveForkPolicy 2}}selected{{end}} {{if lt 2 .SiteForkPolicy}}disabled{{end}}>{{ctx.Locale.Tr "org.settings.private_fork_policy.none"}}</option>
								</select>
								<p class="help">{{ctx.Locale.Tr "org.settings.private_fork_policy_help"}}</p>
								{{if .SiteForkPolicy}}<p class="help site-policy-floor">{{ctx.Locale.Tr "org.settings.site_policy_floor"}}</p>{{end}}
							</div>
						</div>

						{{if .CanSetOrgCategory}}
						<div class="field" id="category_box">
							<input type="hidden" name="category_shown" value="true">
							<label for="category_id">{{ctx.Locale.Tr "org.settings.category"}}</label>
							<select id="category_id" name="category_id">
								<option value="0">{{ctx.Locale.Tr "org.settings.category.none"}}</option>
								{{range .OrgCategories}}
									<option value="{{.ID}}" {{if eq .ID $.Org.CategoryID}}selected{{end}}>{{.Name}}</option>
								{{end}}
							</select>
							<p class="help">{{ctx.Locale.Tr "org.settings.category_help"}}</p>
						</div>

						{{end}}
						<div class="field" id="permission_box">
							<label>{{ctx.Locale.Tr "org.settings.permission"}}</label>
							<div class="field">
								<div class="ui checkbox">
									<input type="checkbox" name="repo_admin_change_team_access" {{if .RepoAdminChangeTeamAccess}}checked{{end}}>
									<label>{{ctx.Locale.Tr "org.settings.repoadminchangeteam"}}</label>
								</div>
							</div>
						</div>

						<div class="field" id="require_two_factor_box">
							<input type="hidden" name="require_two_factor_shown" value="true">
							<div class="ui checkbox">
								<input type="checkbox" name="require_two_factor" {{if .RequireTwoFactor}}checked{{end}}>
								<label>{{ctx.Locale.Tr "org.settings.require_two_factor"}}</label>
							</div>
							<p class="help">{{ctx.Locale.Tr "org.settings.require_two_factor_desc"}}</p>
							{{if .RequireTwoFactorConfirm}}
								<div class="ui warning message require-two-factor-confirm">
									{{if .RequireTwoFactorMembers}}
										<p>{{ctx.Locale.Tr "org.settings.require_two_factor_members_without"}}</p>
										<ul class="require-two-factor-members">
											{{range .RequireTwoFactorMembers}}
												<li><a href="{{.HomeLink}}">{{.Name}}</a>{{if index $.RequireTwoFactorOwners .ID}} <span class="ui basic label">{{ctx.Locale.Tr "org.members.owner"}}</span>{{end}}</li>
											{{end}}
										</ul>
									{{else}}
										<p>{{ctx.Locale.Tr "org.settings.require_two_factor_all_members_have"}}</p>
									{{end}}
									<div class="ui checkbox">
										<input type="checkbox" name="require_two_factor_confirm" required>
										<label>{{ctx.Locale.Tr "org.settings.require_two_factor_confirm"}}</label>
									</div>
								</div>
							{{end}}
						</div>

						{{if .SignedUser.IsAdmin}}
						<div class="divider"></div>

						<div class="inline field {{if .Err_MaxRepoCreation}}error{{end}}">
							<label for="max_repo_creation">{{ctx.Locale.Tr "admin.users.max_repo_creation"}}</label>
							<input id="max_repo_creation" name="max_repo_creation" type="number" min="-1" value="{{.Org.MaxRepoCreation}}">
							<p class="help">{{ctx.Locale.Tr "admin.users.max_repo_creation_desc"}}</p>
						</div>
						{{end}}

						<div class="field">
							<button class="ui primary button">{{ctx.Locale.Tr "org.settings.update_settings"}}</button>
						</div>
					</form>

					<div class="divider"></div>

					<form class="ui form" action="{{.Link}}/avatar" method="post" enctype="multipart/form-data">
						<div class="inline field">
							<label for="new-avatar">{{ctx.Locale.Tr "settings.choose_new_avatar"}}</label>
							<input id="new-avatar" name="avatar" aria-describedby="new-avatar-description" type="file" accept="image/png,image/jpeg,image/gif,image/webp">
							<br/><span id="new-avatar-description" class=help>{{ctx.Locale.Tr "avatar.constraints_hint" (ctx.Locale.TrSize .MaxAvatarFileSize) .MaxAvatarWidth .MaxAvatarHeight}}</span>
						</div>

						<div class="field button-sequence">
							<button class="primary button">{{ctx.Locale.Tr "settings.update_avatar"}}</button>
							<button class="danger button link-action" data-url="{{.Link}}/avatar/delete">{{ctx.Locale.Tr "settings.delete_current_avatar"}}</button>
						</div>
					</form>
				</div>
			</div>
{{template "org/settings/layout_footer" .}}
