{{/* ctxData, ID: form ID suffix, All: covers all repositories, RepoIDs: the selected repositories, comma-separated */}}
<div class="field">
	<label>{{ctx.Locale.Tr "org.settings.deploy_key_scope"}}</label>
	<div class="field">
		<div class="ui radio checkbox">
			<input id="deploy-key-scope-all-{{.ID}}" name="scope" type="radio" value="all" {{if .All}}checked{{end}}>
			<label for="deploy-key-scope-all-{{.ID}}">{{ctx.Locale.Tr "org.settings.deploy_key_all_repos"}}</label>
		</div>
	</div>
	<div class="field">
		<div class="ui radio checkbox">
			<input id="deploy-key-scope-selected-{{.ID}}" name="scope" type="radio" value="selected" {{if not .All}}checked{{end}}>
			<label for="deploy-key-scope-selected-{{.ID}}">{{ctx.Locale.Tr "org.settings.deploy_key_selected_repos"}}</label>
		</div>
	</div>
	<div id="deploy-key-repos-{{.ID}}" class="field tw-pl-[26px]">
		<div class="ui multiple search selection dropdown">
			<input type="hidden" name="repo_ids" value="{{.RepoIDs}}">
			<input class="search" type="text" autocomplete="off" aria-label="{{ctx.Locale.Tr "org.settings.deploy_key_select_repos"}}">
			<div class="default text">{{ctx.Locale.Tr "org.settings.deploy_key_select_repos"}}</div>
			<div class="menu">
				{{range .ctxData.Repos}}
					<div class="item" data-value="{{.ID}}">{{.Name}}</div>
				{{end}}
			</div>
		</div>
	</div>
</div>
