{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository security-alerts secret-alerts">
	{{template "repo/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		<div class="repo-security-layout">
		{{template "repo/security/menu" .}}
		<div class="repo-security-main">
		<h2 class="ui header repo-security-heading">{{ctx.Locale.Tr "repo.secrets.title"}}</h2>
		{{if .SecretScanningOn}}
		<div class="repo-security-header">
			<nav class="repo-security-tabs" aria-label="{{ctx.Locale.Tr "repo.secrets.title"}}">
				<a class="item{{if not .Closed}} active{{end}}"{{if not .Closed}} aria-current="page"{{end}} href="{{.RepoLink}}/security/secrets">{{ctx.Locale.TrPluralString .SecretOpenCount "repo.secrets.tab.open" (ctx.Locale.PrettyNumber .SecretOpenCount)}}</a>
				<a class="item{{if .Closed}} active{{end}}"{{if .Closed}} aria-current="page"{{end}} href="{{.RepoLink}}/security/secrets?state=closed">{{ctx.Locale.TrPluralString .SecretClosedCount "repo.secrets.tab.closed" (ctx.Locale.PrettyNumber .SecretClosedCount)}}</a>
			</nav>
			<div class="text grey secret-scan-status" id="secret-scan-status">
				{{if eq .ScanStatus.Status "failed"}}
					<strong class="text red">{{ctx.Locale.Tr "repo.secrets.status.failed"}}</strong>
				{{else if eq .ScanStatus.Status "incomplete"}}
					<strong class="text yellow">{{ctx.Locale.Tr "repo.secrets.status.incomplete"}}</strong>{{if .LastScanned}} · {{ctx.Locale.Tr "repo.secrets.status.last_scanned" (DateUtils.TimeSince .LastScanned)}}{{end}}
				{{else if eq .ScanStatus.Status "ok"}}
					{{ctx.Locale.Tr "repo.secrets.status.last_scanned" (DateUtils.TimeSince .LastScanned)}}
				{{else if .TotalSecretAlerts}}
					{{ctx.Locale.Tr "repo.secrets.status.queued"}}
				{{else}}
					{{ctx.Locale.Tr "repo.secrets.status.never"}}
				{{end}}
				{{if .CanRescan}}
					<form class="tw-inline" method="post" action="{{.RepoLink}}/security/secrets/rescan">
						<button class="ui basic compact small button" id="secret-rescan">{{ctx.Locale.Tr "repo.secrets.rescan"}}</button>
					</form>
				{{end}}
			</div>
		</div>

		{{end}}
		{{if not .SecretScanningOn}}
			<div class="ui warning message" id="secret-banner-off">
				<div class="header">{{ctx.Locale.Tr "repo.secrets.off.title"}}</div>
				<p>
					{{if not .Switch.Site}}{{ctx.Locale.Tr "repo.secrets.off.site"}}
					{{else if and .Switch.Org (not .Switch.Org.On)}}{{ctx.Locale.Tr "repo.secrets.off.org" .Repository.OwnerName}}
					{{else if .OffBy}}{{ctx.Locale.Tr "repo.secrets.off.by" .OffBy (DateUtils.AbsoluteShort .OffAt)}}
					{{else}}{{ctx.Locale.Tr "repo.secrets.off.repo"}}{{end}}
					{{ctx.Locale.Tr "repo.secrets.off.kept"}}
					{{if and .Switch.Site .Switch.CanChange}}
						{{if .IsRepositoryAdmin}}<a href="{{.RepoLink}}/settings/code_security">{{ctx.Locale.Tr "repo.secrets.off.turn_on"}}</a>{{else}}{{ctx.Locale.Tr "repo.secrets.off.ask_admin"}}{{end}}
					{{end}}
				</p>
			</div>
		{{else if eq .ScanStatus.Status "failed"}}
			<div class="ui negative message" id="secret-banner-failed">
				<div class="header">{{ctx.Locale.Tr "repo.secrets.failed.title"}}</div>
				<p>{{if .IsRepositoryAdmin}}{{ctx.Locale.Tr "repo.secrets.failed.text"}}{{else}}{{ctx.Locale.Tr "repo.secrets.failed.ask"}}{{end}}</p>
			</div>
		{{else if eq .ScanStatus.Status "incomplete"}}
			<div class="ui warning message" id="secret-banner-incomplete">
				<div class="header">{{ctx.Locale.Tr "repo.secrets.incomplete.title"}}</div>
				<p>{{if .IsRepositoryAdmin}}{{ctx.Locale.Tr "repo.secrets.incomplete.text"}}{{else}}{{ctx.Locale.Tr "repo.secrets.incomplete.ask"}}{{end}}{{if .ScanStatus.Holes}} {{ctx.Locale.TrPluralString .ScanStatus.Holes "repo.secrets.incomplete.holes" (ctx.Locale.PrettyNumber .ScanStatus.Holes)}}{{end}}</p>
			</div>
		{{end}}

		{{if .SecretScanningOn}}
		{{if .TotalSecretAlerts}}
		<form class="ui form repo-security-filters" method="get" action="{{.RepoLink}}/security/secrets">
			{{if .Closed}}<input type="hidden" name="state" value="closed">{{end}}
			<input type="search" name="q" value="{{.Query}}" maxlength="256" placeholder="{{ctx.Locale.Tr "repo.secrets.search"}}" aria-label="{{ctx.Locale.Tr "repo.secrets.search"}}">
			<label>{{ctx.Locale.Tr "repo.secrets.type"}}
				<select name="type">
					<option value="">{{ctx.Locale.Tr "repo.secrets.all_types"}}</option>
					{{range .TypeOptions}}<option value="{{.ID}}"{{if eq .ID $.Type}} selected{{end}}>{{.Name}}</option>{{end}}
				</select>
			</label>
			<label>{{ctx.Locale.Tr "repo.secrets.found"}}
				<select name="found">
					<option value="">{{ctx.Locale.Tr "repo.secrets.found.all"}}</option>
					{{range .FoundOptions}}<option value="{{.}}"{{if eq . $.Found}} selected{{end}}>{{ctx.Locale.Tr (printf "repo.secrets.found.%s" .)}}</option>{{end}}
				</select>
			</label>
			{{if .Closed}}
			<label>{{ctx.Locale.Tr "repo.secrets.reason"}}
				<select name="reason">
					<option value="">{{ctx.Locale.Tr "repo.secrets.all_reasons"}}</option>
					{{range .ClosedStates}}<option value="{{.}}"{{if eq . $.Reason}} selected{{end}}>{{ctx.Locale.Tr (printf "repo.secrets.reason.%s" .)}}</option>{{end}}
				</select>
			</label>
			{{end}}
			<label>{{ctx.Locale.Tr "repo.secrets.sort"}}
				<select name="sort">
					<option value="">{{ctx.Locale.Tr "repo.secrets.sort.newest"}}</option>
					<option value="oldest"{{if eq .Sort "oldest"}} selected{{end}}>{{ctx.Locale.Tr "repo.secrets.sort.oldest"}}</option>
				</select>
			</label>
			<button class="ui basic button" type="submit">{{ctx.Locale.Tr "repo.secrets.filter"}}</button>
		</form>
		{{end}}

		{{if .FilterIgnored}}<div class="ui warning message" id="secret-filter-ignored">{{ctx.Locale.Tr "repo.secrets.filter_ignored"}}</div>{{end}}
		{{if .Alerts}}
			{{if and .CanCloseSecretAlerts (not .Closed)}}
				<div class="secret-bulk tw-hidden" id="secret-bulk" role="status" data-text-one="{{ctx.Locale.TrPluralString 1 "repo.secrets.bulk.selected" "{n}"}}" data-text-other="{{ctx.Locale.TrPluralString 2 "repo.secrets.bulk.selected" "{n}"}}" data-title-one="{{ctx.Locale.TrPluralString 1 "repo.secrets.bulk.title" "{n}"}}" data-title-other="{{ctx.Locale.TrPluralString 2 "repo.secrets.bulk.title" "{n}"}}" data-submit-one="{{ctx.Locale.Tr "repo.secrets.close.submit"}}" data-submit-other="{{ctx.Locale.Tr "repo.secrets.bulk.submit"}}" data-ask-one="{{ctx.Locale.TrPluralString 1 "repo.secrets.bulk.reason"}}" data-ask-other="{{ctx.Locale.TrPluralString 2 "repo.secrets.bulk.reason"}}">
					<strong id="secret-bulk-count"></strong>
					<button type="button" class="ui basic compact button show-modal" data-modal="#secret-bulk-modal">{{ctx.Locale.Tr "repo.secrets.bulk.button"}}</button>
					<span class="text grey">{{ctx.Locale.Tr "repo.secrets.bulk.help"}}</span>
				</div>
			{{end}}
			<div class="repo-security-table secret-alerts-table" role="table" aria-label="{{ctx.Locale.Tr "repo.secrets.title"}}">
				<div class="repo-security-row repo-security-head" role="row">
					<span role="columnheader">
						{{if and .CanCloseSecretAlerts (not .Closed)}}<label class="secret-check-hit"><input type="checkbox" id="secret-select-all" aria-label="{{ctx.Locale.Tr "repo.secrets.select_all"}}"></label> {{ctx.Locale.Tr "repo.secrets.type"}}{{else}}{{ctx.Locale.Tr "repo.secrets.type"}}{{end}}
					</span>
					<span role="columnheader">{{ctx.Locale.Tr "repo.secrets.first_location"}}</span>
					<span role="columnheader">{{if .Closed}}{{ctx.Locale.Tr "repo.secrets.closed"}}{{else}}{{ctx.Locale.Tr "repo.secrets.first_seen"}}{{end}}</span>
					<span role="columnheader">{{ctx.Locale.Tr "repo.secrets.state"}}</span>
				</div>
				{{range .Alerts}}
					<div class="repo-security-row" role="row">
						<span role="cell" class="repo-security-title">
							<span class="secret-check">
								{{if and $.CanCloseSecretAlerts (not $.Closed)}}<label class="secret-check-hit"><input type="checkbox" form="secret-bulk-form" name="index" value="{{.Index}}" aria-label="{{ctx.Locale.Tr "repo.secrets.select" .Name}}"></label>{{end}}
								<a href="{{$.RepoLink}}/security/secrets/{{.Index}}"><strong>{{.Name}}</strong></a>
								{{if .Generic}}<span class="ui mini yellow label">{{ctx.Locale.Tr "repo.secrets.generic"}}</span>{{end}}
							</span>
						</span>
						<span role="cell" class="secret-first">
							<span class="repo-security-cell-label">{{ctx.Locale.Tr "repo.secrets.first_location"}}</span>
							{{if .FirstText}}{{if .FirstText.Readable}}<a href="{{$.RepoLink}}/{{if .FirstText.IsPull}}pulls{{else}}issues{{end}}/{{.FirstText.Number}}{{if eq .First.Kind "comment"}}#issuecomment-{{.First.SourceID}}{{end}}">{{if .FirstText.IsPull}}{{ctx.Locale.Tr "repo.secrets.loc.pull_ref" .FirstText.Number}}{{else}}{{ctx.Locale.Tr "repo.secrets.loc.issue_ref" .FirstText.Number}}{{end}}</a> <span class="text grey">· {{ctx.Locale.Tr (printf "repo.secrets.loc.field.%s" .FirstText.FieldName)}}</span>{{else if .FirstText.Deleted}}<span class="text grey">{{if eq .First.Kind "comment"}}{{ctx.Locale.Tr "repo.secrets.loc.deleted_comment"}}{{else}}{{ctx.Locale.Tr "repo.secrets.loc.deleted_issue"}}{{end}}</span>{{else}}<span class="text grey">{{ctx.Locale.Tr (printf "repo.secrets.loc.in_%s" .First.Kind)}}</span>{{end}}
							{{else if .First}}<code>{{.First.Path}}{{if .First.StartLine}}:{{.First.StartLine}}{{end}}</code>{{end}}
							{{if .More}} <span class="text grey small">{{ctx.Locale.Tr "repo.secrets.more" (ctx.Locale.PrettyNumber .More)}}</span>{{end}}
						</span>
						<span role="cell" class="secret-when">
							<span class="repo-security-cell-label">{{if $.Closed}}{{ctx.Locale.Tr "repo.secrets.closed"}}{{else}}{{ctx.Locale.Tr "repo.secrets.first_seen"}}{{end}}</span>
							{{if $.Closed}}
								{{if .ClosedBy}}{{.ClosedBy.GetDisplayName}}, {{end}}{{DateUtils.TimeSince .ClosedUnix}}
							{{else}}
								{{DateUtils.TimeSince .CreatedUnix}}
							{{end}}
						</span>
						<span role="cell">
							{{if eq .State "open"}}<span class="ui small label vuln-state vuln-state-open">{{ctx.Locale.Tr "repo.secrets.state.open"}}</span>
							{{else if eq .State "wont_fix"}}<span class="ui small label vuln-state-warning">{{ctx.Locale.Tr (printf "repo.secrets.reason.%s" .State)}}</span>
							{{else}}<span class="ui small basic label">{{ctx.Locale.Tr (printf "repo.secrets.reason.%s" .State)}}</span>{{end}}
						</span>
					</div>
				{{end}}
			</div>
			{{template "base/paginate" .}}
		{{else if .HasFilter}}
			<div class="ui info message" id="secret-no-match">
				{{ctx.Locale.Tr "repo.secrets.no_match"}}
				<a class="repo-security-clear" href="{{.RepoLink}}/security/secrets{{if .Closed}}?state=closed{{end}}">{{ctx.Locale.Tr "repo.secrets.clear"}}</a>
			</div>
		{{else if .TotalSecretAlerts}}
			<div class="ui info message" id="secret-empty-state">
				{{if .Closed}}{{ctx.Locale.Tr "repo.secrets.empty.closed"}}{{else}}{{ctx.Locale.Tr "repo.secrets.empty.open"}}{{end}}
			</div>
		{{else if eq .ScanStatus.Status "pending"}}
			<div class="ui info message" id="secret-waiting">
				<div class="header">{{ctx.Locale.Tr "repo.secrets.waiting.title"}}</div>
				<p>{{ctx.Locale.Tr "repo.secrets.waiting.text"}}</p>
			</div>
		{{else}}
			<div class="ui info message" id="secret-empty">
				<div class="header">{{ctx.Locale.Tr "repo.secrets.empty.title"}}</div>
				<p>{{ctx.Locale.Tr "repo.secrets.empty.text"}}</p>
			</div>
		{{end}}
		{{end}}
		</div>
		</div>
	</div>
</div>
{{if and .CanCloseSecretAlerts (not .Closed) .Alerts}}{{template "repo/security/secret_close_modal" (dict "ID" "secret-bulk-modal" "FormID" "secret-bulk-form" "Action" (printf "%s/security/secrets/close" .RepoLink) "Title" (ctx.Locale.Tr "repo.secrets.bulk.title_neutral") "Submit" (ctx.Locale.Tr "repo.secrets.bulk.submit") "MaxCommentLen" .MaxCommentLen)}}{{end}}
{{template "base/footer" .}}
