{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository security-alert secret-alert">
	{{template "repo/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		{{$alert := .Alert}}
		<div class="repo-security-layout">
		{{template "repo/security/menu" .}}
		<div class="repo-security-main">
		<div class="breadcrumb tw-mb-3">
			<a href="{{.RepoLink}}/security/secrets">{{ctx.Locale.Tr "repo.secrets.title"}}</a> › {{$alert.Name}} #{{$alert.Index}}
		</div>
		<div class="secret-title">
			<h2 class="ui header tw-m-0">{{$alert.Name}}</h2>
			{{if $.CanCloseSecretAlerts}}
				{{if eq $alert.State "open"}}
					<button type="button" class="ui basic button show-modal" id="secret-close" data-modal="#secret-close-modal">{{ctx.Locale.Tr "repo.secrets.close_button"}}</button>
				{{else}}
					<form method="post" action="{{.RepoLink}}/security/secrets/{{$alert.Index}}/reopen">
						<button class="ui basic button" id="secret-reopen">{{ctx.Locale.Tr "repo.secrets.reopen"}}</button>
					</form>
				{{end}}
			{{end}}
		</div>
		<div class="repo-security-badges">
			{{if eq $alert.State "open"}}<span class="ui small label vuln-state vuln-state-open" id="alert-state">{{ctx.Locale.Tr "repo.secrets.state.open"}}</span>
			{{else if eq $alert.State "wont_fix"}}<span class="ui small label vuln-state-warning" id="alert-state">{{ctx.Locale.Tr (printf "repo.secrets.closed_as.%s" $alert.State)}}</span>
			{{else}}<span class="ui small basic label" id="alert-state">{{ctx.Locale.Tr (printf "repo.secrets.closed_as.%s" $alert.State)}}</span>{{end}}
			{{if $alert.Generic}}<span class="ui small yellow label">{{ctx.Locale.Tr "repo.secrets.generic"}}</span>{{end}}
			<span class="text grey">{{if and $alert.ViaPull .TextOnly}}{{ctx.Locale.Tr "repo.secrets.first_seen_text" (DateUtils.TimeSince $alert.CreatedUnix)}}{{else if $alert.ViaPull}}{{ctx.Locale.Tr "repo.secrets.first_seen_pull" (DateUtils.TimeSince $alert.CreatedUnix)}}{{else}}{{ctx.Locale.Tr "repo.secrets.first_seen_on" (DateUtils.TimeSince $alert.CreatedUnix)}}{{end}}</span>
		</div>
		{{if ne $alert.State "open"}}
			<div class="secret-closed-note" id="secret-closed-note">
				<div>{{if and $alert.ClosedBy $alert.ClosedUnix}}{{ctx.Locale.Tr "repo.secrets.closed_by" $alert.ClosedBy.GetDisplayName (DateUtils.AbsoluteShort $alert.ClosedUnix)}}
					{{else if $alert.ClosedBy}}{{ctx.Locale.Tr "repo.secrets.closed_by_only" $alert.ClosedBy.GetDisplayName}}
					{{else if $alert.ClosedUnix}}{{ctx.Locale.Tr "repo.secrets.closed_on" (DateUtils.AbsoluteShort $alert.ClosedUnix)}}
					{{else}}{{ctx.Locale.Tr "repo.secrets.closed_plain"}}{{end}}</div>
				{{if $alert.Comment}}<div class="text grey secret-comment">{{$alert.Comment}}</div>{{end}}
			</div>
		{{end}}

		<div class="ui message secret-guidance" id="secret-guidance">
			{{if eq .Guidance.Key "provider"}}
				<div class="header">{{if eq $alert.State "open"}}{{ctx.Locale.Tr "repo.secrets.guidance.revoke"}}{{else}}{{ctx.Locale.Tr "repo.secrets.guidance.revoke_closed"}}{{end}}</div>
				<p>{{if .TextOnly}}{{ctx.Locale.Tr "repo.secrets.guidance.history_text"}}{{else if .TextAlso}}{{ctx.Locale.Tr "repo.secrets.guidance.history_both"}}{{else}}{{ctx.Locale.Tr "repo.secrets.guidance.history"}}{{end}}</p>
				<ul><li><a href="{{.Guidance.URL}}" target="_blank" rel="noopener noreferrer">{{if eq .Guidance.Provider "aws"}}{{ctx.Locale.Tr "repo.secrets.guidance.link_aws"}}{{else if eq .Guidance.Provider "slack"}}{{ctx.Locale.Tr "repo.secrets.guidance.link_slack"}}{{else if eq .Guidance.Provider "github"}}{{ctx.Locale.Tr "repo.secrets.guidance.link_github"}}{{else if eq .Guidance.Provider "gitlab"}}{{ctx.Locale.Tr "repo.secrets.guidance.link_gitlab"}}{{else if eq .Guidance.Provider "gcp"}}{{ctx.Locale.Tr "repo.secrets.guidance.link_gcp"}}{{else if eq .Guidance.Provider "azure"}}{{ctx.Locale.Tr "repo.secrets.guidance.link_azure"}}{{else}}{{ctx.Locale.Tr "repo.secrets.guidance.link_stripe"}}{{end}}</a></li></ul>
			{{else if eq .Guidance.Key "private_key"}}
				<div class="header">{{ctx.Locale.Tr "repo.secrets.guidance.replace"}}</div>
				<p>{{if .TextOnly}}{{ctx.Locale.Tr "repo.secrets.guidance.private_key_text"}}{{else if .TextAlso}}{{ctx.Locale.Tr "repo.secrets.guidance.private_key_both"}}{{else}}{{ctx.Locale.Tr "repo.secrets.guidance.private_key"}}{{end}}</p>
			{{else if eq .Guidance.Key "generic"}}
				<div class="header">{{ctx.Locale.Tr "repo.secrets.guidance.check"}}</div>
				<p>{{ctx.Locale.Tr "repo.secrets.guidance.generic"}}</p>
			{{else}}
				<div class="header">{{if eq $alert.State "open"}}{{ctx.Locale.Tr "repo.secrets.guidance.revoke"}}{{else}}{{ctx.Locale.Tr "repo.secrets.guidance.revoke_closed"}}{{end}}</div>
				<p>{{if .TextOnly}}{{ctx.Locale.Tr "repo.secrets.guidance.history_text"}}{{else if .TextAlso}}{{ctx.Locale.Tr "repo.secrets.guidance.history_both"}}{{else}}{{ctx.Locale.Tr "repo.secrets.guidance.history"}}{{end}} {{ctx.Locale.Tr "repo.secrets.guidance.other"}}</p>
			{{end}}
		</div>

		<dl class="repo-security-facts">
			<dt>{{ctx.Locale.Tr "repo.secrets.type"}}</dt>
			<dd>{{$alert.Name}}</dd>
			<dt>{{ctx.Locale.Tr "repo.secrets.rule"}}</dt>
			<dd><code>{{$alert.RuleID}}</code></dd>
			<dt>{{ctx.Locale.Tr "repo.secrets.fingerprint"}}</dt>
			<dd>
				<code id="secret-fingerprint">{{.ShortFingerprint}}</code>
				<button type="button" class="ui basic compact small button" data-clipboard-text="{{.ShortFingerprint}}" aria-label="{{ctx.Locale.Tr "repo.secrets.copy_fingerprint"}}">{{svg "octicon-copy"}} {{ctx.Locale.Tr "copy"}}</button>
				<div class="help">{{ctx.Locale.Tr "repo.secrets.fingerprint_help"}}</div>
			</dd>
		</dl>

		<h3>{{ctx.Locale.Tr "repo.secrets.locations"}}</h3>
		<div class="repo-security-table secret-locations" role="table" aria-label="{{ctx.Locale.Tr "repo.secrets.locations"}}">
			<div class="repo-security-row repo-security-head" role="row">
				<span role="columnheader">{{ctx.Locale.Tr "repo.secrets.loc.kind"}}</span>
				<span role="columnheader">{{ctx.Locale.Tr "repo.secrets.loc.location"}}</span>
				<span role="columnheader">{{ctx.Locale.Tr "repo.secrets.loc.commit"}}</span>
				<span role="columnheader">{{ctx.Locale.Tr "repo.secrets.loc.author"}}</span>
				<span role="columnheader">{{ctx.Locale.Tr "repo.secrets.loc.date"}}</span>
			</div>
			{{range $i, $_ := .Locations}}
				{{if or (StringUtils.HasPrefix .Type "issue_") (StringUtils.HasPrefix .Type "pull_request_") (eq .Type "comment_text")}}
				<div class="repo-security-row" role="row">
					<span role="cell"><span class="repo-security-cell-label">{{ctx.Locale.Tr "repo.secrets.loc.kind"}}</span> <span class="ui basic mini label">{{if eq .Type "issue_text"}}{{ctx.Locale.Tr "repo.secrets.loc.in_issue"}}{{else if eq .Type "comment_text"}}{{ctx.Locale.Tr "repo.secrets.loc.in_comment"}}{{else if StringUtils.HasPrefix .Type "pull_request_"}}{{ctx.Locale.Tr "repo.secrets.loc.pull_text"}}{{else}}{{ctx.Locale.Tr "repo.secrets.loc.issue_text"}}{{end}}</span></span>
					<span role="cell"><span class="repo-security-cell-label">{{ctx.Locale.Tr "repo.secrets.loc.location"}}</span>
						{{if .Details.IssueNumber}}<a href="{{.Details.HTMLURL}}">{{if StringUtils.HasPrefix .Type "pull_request_"}}{{ctx.Locale.Tr "repo.secrets.loc.pull_ref" .Details.IssueNumber}}{{else}}{{ctx.Locale.Tr "repo.secrets.loc.issue_ref" .Details.IssueNumber}}{{end}}</a> <span class="text grey">· {{ctx.Locale.Tr (printf "repo.secrets.loc.field.%s" .Details.Field)}}{{if gt .Details.StartLine 1}}, {{ctx.Locale.Tr "repo.secrets.loc.line" .Details.StartLine}}{{end}}</span>
						{{if .Details.Removed}}<span class="ui basic mini label">{{ctx.Locale.Tr "repo.secrets.loc.removed"}}</span>{{end}}
						{{else if .Details.Removed}}<span class="text grey">{{if eq .Type "comment_text"}}{{ctx.Locale.Tr "repo.secrets.loc.deleted_comment"}}{{else}}{{ctx.Locale.Tr "repo.secrets.loc.deleted_issue"}}{{end}}</span>
						{{else}}<span class="text grey">{{ctx.Locale.Tr "repo.secrets.loc.hidden"}}</span>{{end}}
					</span>
					<span role="cell"></span>
					<span role="cell">{{with index $.Posters $i}}<span class="repo-security-cell-label">{{ctx.Locale.Tr "repo.secrets.loc.author"}}</span> {{template "shared/user/namelink" .}}{{end}}</span>
					<span role="cell">{{if and $.CanCloseSecretAlerts .Details.IssueNumber (not .Details.Removed)}}
						<button type="button" class="ui basic mini button show-modal secret-redact" data-modal="#secret-redact-modal" data-modal-secret-redact-issue="{{.Details.IssueNumber}}" data-modal-secret-redact-field="{{.Details.Field}}" data-modal-secret-redact-comment="{{.Details.CommentID}}" data-modal-secret-redact-where="{{if StringUtils.HasPrefix .Type "pull_request_"}}{{ctx.Locale.Tr "repo.secrets.loc.pull_ref" .Details.IssueNumber}}{{else}}{{ctx.Locale.Tr "repo.secrets.loc.issue_ref" .Details.IssueNumber}}{{end}} · {{ctx.Locale.Tr (printf "repo.secrets.loc.field.%s" .Details.Field)}}">{{svg "octicon-eye-closed"}} {{ctx.Locale.Tr "repo.secrets.redact.button"}}</button>
					{{end}}</span>
				</div>
				{{else}}
				<div class="repo-security-row" role="row">
					<span role="cell"><span class="repo-security-cell-label">{{ctx.Locale.Tr "repo.secrets.loc.kind"}}</span> <span class="ui basic mini label">{{if eq .Type "wiki_commit"}}{{ctx.Locale.Tr "repo.secrets.loc.wiki"}}{{else if .Details.PullRef}}{{ctx.Locale.Tr "repo.secrets.loc.pull"}}{{else}}{{ctx.Locale.Tr "repo.secrets.loc.code"}}{{end}}</span></span>
					<span role="cell"><span class="repo-security-cell-label">{{ctx.Locale.Tr "repo.secrets.loc.file"}}</span>
						{{if .Details.PageURL}}<a href="{{.Details.PageURL}}">{{with index $.WikiTitles .Details.Path}}{{.}} {{end}}<code>{{.Details.Path}}{{if .Details.StartLine}}:{{.Details.StartLine}}{{end}}</code></a>
						{{else if .Details.HTMLURL}}<a href="{{.Details.HTMLURL}}"><code>{{.Details.Path}}{{if .Details.StartLine}}:{{.Details.StartLine}}{{end}}</code></a>
						{{else}}<code>{{.Details.Path}}</code>{{end}}
					</span>
					<span role="cell"><span class="repo-security-cell-label">{{ctx.Locale.Tr "repo.secrets.loc.commit"}}</span> {{if .Details.CommitSHA}}{{if .Details.PageURL}}<code>{{ShortSha .Details.CommitSHA}}</code>{{else}}<a href="{{$.RepoLink}}/commit/{{.Details.CommitSHA}}"><code>{{ShortSha .Details.CommitSHA}}</code></a>{{end}}{{end}}</span>
					<span role="cell"><span class="repo-security-cell-label">{{ctx.Locale.Tr "repo.secrets.loc.author"}}</span> {{.Details.CommitAuthorName}}</span>
					<span role="cell"><span class="repo-security-cell-label">{{ctx.Locale.Tr "repo.secrets.loc.date"}}</span> {{if .Details.CommitDate}}{{DateUtils.AbsoluteShort .Details.CommitDate}}{{end}}</span>
				</div>
				{{end}}
			{{end}}
			{{if .AnyHidden}}
				<div class="secret-locations-note text grey">{{ctx.Locale.Tr "repo.secrets.loc.hidden_note"}}</div>
			{{end}}
			{{if .NotListed}}
				<div class="secret-locations-note text grey">{{ctx.Locale.TrPluralString .NotListed "repo.secrets.not_listed" (ctx.Locale.PrettyNumber .NotListed)}}</div>
			{{end}}
		</div>
		{{template "base/paginate" .}}

		<h3>{{ctx.Locale.Tr "repo.secrets.activity"}}</h3>
		<ul class="repo-security-table secret-activity" id="secret-activity">
			<li class="repo-security-row"><span><strong>{{ctx.Locale.Tr "repo.secrets.activity.opened"}}</strong> {{ctx.Locale.Tr "repo.secrets.activity.by_scan"}} · {{DateUtils.AbsoluteShort $alert.CreatedUnix}}</span></li>
			{{range .History}}
				<li class="repo-security-row"><span>
					{{if .Reopened}}<strong>{{.Actor}}</strong> {{ctx.Locale.Tr "repo.secrets.activity.reopened"}}
					{{else if .Redacted}}<strong>{{.Actor}}</strong> {{ctx.Locale.Tr "repo.secrets.activity.redacted"}}
					{{else}}<strong>{{.Actor}}</strong> {{ctx.Locale.Tr (printf "repo.secrets.activity.closed.%s" .State)}}{{end}}
					· {{DateUtils.AbsoluteShort .CreatedUnix}}
					{{if .Comment}}<div class="text grey secret-comment">{{.Comment}}</div>{{end}}
				</span></li>
			{{end}}
		</ul>
		<p class="help">{{ctx.Locale.Tr "repo.secrets.activity.help"}}</p>
		</div>
		</div>
	</div>
</div>
{{if and .CanCloseSecretAlerts (eq $.Alert.State "open")}}{{template "repo/security/secret_close_modal" (dict "ID" "secret-close-modal" "FormID" "secret-close-form" "Action" (printf "%s/security/secrets/%d/close" .RepoLink $.Alert.Index) "Title" (ctx.Locale.Tr "repo.secrets.close.title" $.Alert.Name) "Submit" (ctx.Locale.Tr "repo.secrets.close.submit") "MaxCommentLen" .MaxCommentLen)}}{{end}}
{{if .CanCloseSecretAlerts}}
<dialog class="modal" id="secret-redact-modal" aria-labelledby="secret-redact-modal-heading">
	<article>
		<header id="secret-redact-modal-heading">{{ctx.Locale.Tr "repo.secrets.redact.title"}}</header>
		<div class="content">
			<p><strong id="secret-redact-where"></strong></p>
			<ul>
				<li>{{ctx.Locale.Tr "repo.secrets.redact.replace" "[secret removed]"}}</li>
				<li>{{ctx.Locale.Tr "repo.secrets.redact.history"}}</li>
				<li>{{ctx.Locale.Tr "repo.secrets.redact.undo"}}</li>
			</ul>
			<div class="ui warning message">{{ctx.Locale.Tr "repo.secrets.redact.revoke"}}</div>
		</div>
		<form class="actions" method="post" action="{{.RepoLink}}/security/secrets/{{$.Alert.Index}}/redact">
			<input type="hidden" name="issue" id="secret-redact-issue">
			<input type="hidden" name="field" id="secret-redact-field">
			<input type="hidden" name="comment" id="secret-redact-comment">
			<button type="button" class="ui small basic button" command="close" commandfor="secret-redact-modal">{{svg "octicon-x"}} {{ctx.Locale.Tr "cancel"}}</button>
			<button class="ui small red button" type="submit" id="secret-redact-submit">{{ctx.Locale.Tr "repo.secrets.redact.submit"}}</button>
		</form>
	</article>
</dialog>
{{end}}
{{template "base/footer" .}}
