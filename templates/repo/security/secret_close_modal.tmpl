{{/* The close dialog of a secret alert (or of the selected alerts of the list): the reason has no default */}}
<dialog class="modal" id="{{.ID}}" aria-labelledby="{{.ID}}-heading">
	<article>
		<header id="{{.ID}}-heading" class="secret-modal-title">{{.Title}}</header>
		<form class="ui form ignore-dirty" id="{{.FormID}}" method="post" action="{{.Action}}">
			<div class="content">
				<fieldset class="grouped fields repo-security-reasons">
					<legend class="secret-modal-ask">{{ctx.Locale.Tr "repo.secrets.close.reason"}}</legend>
					{{range $i, $r := (StringUtils.Split "revoked,false_positive,used_in_tests,wont_fix" ",")}}
						<div class="field"><div class="ui radio checkbox"><input type="radio" id="{{$.ID}}-reason-{{$r}}" name="reason" value="{{$r}}"{{if eq $i 0}} required{{end}}><label for="{{$.ID}}-reason-{{$r}}">{{ctx.Locale.Tr (printf "repo.secrets.reason.%s" $r)}}<span class="help">{{ctx.Locale.Tr (printf "repo.secrets.reason_help.%s" $r)}}</span></label></div></div>
					{{end}}
				</fieldset>
				<div class="field">
					<label for="{{.ID}}-comment">{{ctx.Locale.Tr "repo.secrets.close.comment"}}</label>
					<textarea id="{{.ID}}-comment" name="comment" rows="2" data-max-bytes="{{.MaxCommentLen}}" data-too-long="{{ctx.Locale.Tr "repo.secrets.close.too_long" .MaxCommentLen}}"></textarea>
				</div>
				<p class="help">{{ctx.Locale.Tr "repo.secrets.close.help"}}</p>
			</div>
			<div class="actions">
				<button type="button" class="ui small basic cancel button">{{svg "octicon-x"}} {{ctx.Locale.Tr "cancel"}}</button>
				<button class="ui small red approve button" type="submit">{{.Submit}}</button>
			</div>
		</form>
	</article>
</dialog>
