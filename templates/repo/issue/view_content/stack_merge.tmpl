{{$stack := .Stack}}
{{$count := len $stack.Chain}}
<div class="pull-stack-merge" id="pull-stack-merge">
	<div>
		{{ctx.Locale.Tr "repo.pulls.stack.stacked_on" (HTMLFormat `<a href="%s">#%d</a>` $stack.Parent.Link $stack.Parent.Index) (HTMLFormat "<code>%s</code>" .Issue.PullRequest.BaseBranch) (HTMLFormat "<code>%s</code>" $stack.Base)}}
	</div>
	{{if $stack.CanMerge}}
		{{if $stack.Blocked}}
			<div class="text red" id="merge-stack-blocked">{{svg "octicon-x" 16}} {{$stack.Blocked}}</div>
		{{else if $stack.TooLong}}
			<div class="text red" id="merge-stack-blocked">{{svg "octicon-x" 16}} {{ctx.Locale.Tr "repo.pulls.stack.chain_too_long" $stack.MaxMerge}}</div>
		{{end}}
		{{range $stack.Warnings}}
			<div class="text yellow">{{svg "octicon-alert" 16}} {{.}}</div>
		{{end}}
		<div class="pull-stack-actions">
			<button type="button" class="ui primary button" command="show-modal" commandfor="merge-stack" {{if or $stack.Blocked $stack.TooLong}}disabled aria-describedby="merge-stack-blocked"{{end}}>
				{{ctx.Locale.TrPluralString $count "repo.pulls.stack.merge_button" $count $stack.Base}}
			</button>
			<span class="text grey">{{ctx.Locale.Tr "repo.pulls.stack.merges_in_order" $stack.ChainLinks}}</span>
		</div>
	{{end}}
</div>
{{if and $stack.CanMerge (not $stack.Blocked) (not $stack.TooLong)}}
	<dialog class="modal" closedby="any" id="merge-stack" aria-labelledby="merge-stack-title">
		<article>
			<header id="merge-stack-title">{{ctx.Locale.TrPluralString $count "repo.pulls.stack.confirm_title" $count $stack.Base}}</header>
			<form class="ui form" method="post" action="{{.Link}}/merge_stack">
				<div class="content">
					<ol class="pull-stack-confirm-list" role="list">
						{{range $stack.Chain}}
							<li><a href="{{.Link}}">#{{.Index}}</a> {{.Title}} <span class="text grey">· {{ctx.Locale.TrPluralString .Commits "counters.n_commits" (ctx.Locale.PrettyNumber .Commits)}}</span></li>
						{{end}}
					</ol>
					<p>
						{{ctx.Locale.Tr "repo.pulls.stack.confirm_text" (HTMLFormat "<code>%s</code>" $stack.Base)}}
						{{if $stack.ChildrenCount}}{{ctx.Locale.TrPluralString $stack.ChildrenCount "repo.pulls.stack.confirm_children" $stack.Children (HTMLFormat "<code>%s</code>" $stack.Base)}}{{end}}
					</p>
					<div class="field">
						<label for="merge-stack-style">{{ctx.Locale.Tr "repo.pulls.stack.merge_style"}}</label>
						<select id="merge-stack-style" name="do">
							{{range $stack.Styles}}
								<option value="{{.Value}}" {{if eq .Value $stack.DefaultStyle}}selected{{end}}>{{.Text}}</option>
							{{end}}
						</select>
					</div>
					<div class="field">
						<div class="ui checkbox">
							<input type="checkbox" id="merge-stack-delete" name="delete_branch_after_merge" {{if or $stack.DeleteDefault $stack.DeleteForced}}checked{{end}} {{if $stack.DeleteForced}}disabled{{end}}>
							<label for="merge-stack-delete">{{ctx.Locale.TrPluralString $count "repo.pulls.stack.delete_branches" $count}}</label>
						</div>
					</div>
					{{range $stack.Chain}}
						<input type="hidden" name="head" value="{{.Index}}:{{.HeadCommitID}}">
					{{end}}
				</div>
				<div class="actions">
					<button type="button" command="close" commandfor="merge-stack" class="ui button">{{svg "octicon-x"}}{{ctx.Locale.Tr "cancel"}}</button>
					<button type="submit" class="ui primary button">{{svg "octicon-git-merge"}}{{ctx.Locale.TrPluralString $count "repo.pulls.stack.confirm_button" $count}}</button>
				</div>
			</form>
		</article>
	</dialog>
{{end}}
