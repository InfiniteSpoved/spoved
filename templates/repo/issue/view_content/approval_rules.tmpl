{{if .ApprovalRulesError}}
	<div class="item text red">
		{{svg "octicon-x"}}
		{{ctx.Locale.Tr "repo.pulls.approval_rules_error"}}
	</div>
{{end}}
{{if .ApprovalRules}}
	<div class="item">
		<ul class="tw-list-none tw-m-0 tw-p-0">
			{{range .ApprovalRules}}
				<li class="flex-text-block {{if not .Satisfied}}text red{{end}}">
					{{if .Satisfied}}{{svg "octicon-check"}}{{else}}{{svg "octicon-x"}}{{end}}
					{{ctx.Locale.Tr "repo.pulls.approval_rule_status" .Name .Granted .Required}}
					{{if .UncoveredFiles}}{{ctx.Locale.Tr "repo.pulls.approval_rule_uncovered" .UncoveredFiles}}{{end}}
					{{if $.ApprovalRuleEligible}}{{with index $.ApprovalRuleEligible .Rule.ID}}<span class="text grey">{{ctx.Locale.Tr "repo.pulls.approval_rule_eligible" .}}</span>{{end}}{{end}}
					{{if .Approvers}}<span class="text grey">({{range $i, $u := .Approvers}}{{if $i}}, {{end}}{{$u.Name}}{{end}})</span>{{end}}
				</li>
			{{end}}
		</ul>
	</div>
{{end}}
{{range .UncountedApprovals}}
	<div class="item text grey uncounted-approval">
		{{svg "octicon-info"}}
		{{ctx.Locale.Tr "owned_token.approval_uncounted" .}}
	</div>
{{end}}
