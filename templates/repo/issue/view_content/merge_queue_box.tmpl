{{/* the merge box of a pull request in the merge queue */}}
{{$e := .MergeQueueEntry}}
<div class="divider"></div>
<div class="item" id="merge-queue-status">
	{{svg "octicon-git-merge-queue"}}
	<div class="tw-flex tw-flex-col tw-gap-1">
		<strong>{{ctx.Locale.Tr "repo.pulls.merge_queue.queued" .Issue.PullRequest.BaseBranch $e.Position .MergeQueueLength}}</strong>
		<span>
			{{if eq $e.State "merging"}}
				{{ctx.Locale.Tr "repo.pulls.merge_queue.state_merging"}}
			{{else if eq $e.State "grouping"}}
				{{ctx.Locale.Tr "repo.pulls.merge_queue.state_grouping" $e.GroupPassed $e.GroupMin (DateUtils.TimeSince $e.GroupUntil)}}
			{{else if eq $e.State "passed"}}
				{{if eq $e.Position 1}}{{ctx.Locale.Tr "repo.pulls.merge_queue.state_passed_first"}}{{else}}{{$ahead := Eval $e.Position "-" 1}}{{ctx.Locale.TrPluralString $ahead "repo.pulls.merge_queue.state_passed" $ahead}}{{end}}
			{{else if eq $e.State "testing"}}
				{{ctx.Locale.Tr "repo.pulls.merge_queue.state_testing" (DateUtils.TimeSince $e.StartedUnix) .MergeQueueConfig.CheckTimeout.Minutes}}
			{{else}}
				{{ctx.Locale.TrPluralString .MergeQueueConfig.BuildConcurrency "repo.pulls.merge_queue.state_waiting" .MergeQueueConfig.BuildConcurrency}}
			{{end}}
		</span>
		<span class="text grey">
			{{ctx.Locale.Tr "repo.pulls.merge_queue.added_by" $e.EnqueuedBy.GetDisplayName (DateUtils.TimeSince $e.EnqueuedUnix)}}
			{{if $e.TempCommitID}}· <a href="{{$.RepoLink}}/commit/{{PathEscape $e.TempCommitID}}">{{ctx.Locale.Tr "repo.pulls.merge_queue.test_commit" (ShortSha $e.TempCommitID)}}</a>{{end}}
		</span>
	</div>
</div>
<div class="item tw-flex-wrap tw-gap-2" id="merge-queue-actions">
	<a class="ui button" href="{{.MergeQueueLink}}">{{ctx.Locale.Tr "repo.pulls.merge_queue.view"}}</a>
	{{if .CanRemoveFromMergeQueue}}
		<form method="post" action="{{.Link}}/merge_queue/remove">
			<button class="ui red basic button">{{ctx.Locale.Tr "repo.pulls.merge_queue.remove"}}</button>
		</form>
	{{end}}
	<span class="text grey">{{ctx.Locale.Tr "repo.pulls.merge_queue.leaves_on_push"}}</span>
</div>
