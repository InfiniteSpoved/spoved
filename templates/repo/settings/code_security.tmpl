{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings code-security")}}
	<div class="repo-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "repo.dependency_graph"}}
		</h4>
		<div class="ui attached segment">
			<form class="ui form dependency-graph-switch" action="{{.RepoLink}}/settings/code_security" method="post">
				<fieldset {{if not .CanChange}}disabled{{end}}>
					<div class="field">
						<div class="ui checkbox{{if not .CanChange}} disabled{{end}}">
							<input id="dependency-graph-enabled" name="enabled" type="checkbox" aria-describedby="dependency-graph-set-by" {{if .Switch.Enabled}}checked{{end}}>
							<label for="dependency-graph-enabled">
								<strong>{{ctx.Locale.Tr "repo.settings.dependency_graph.enable" .Repository.FullName}}</strong>
								{{if .CanChange}}<span class="help" id="dependency-graph-set-by">{{ctx.Locale.Tr "repo.settings.dependency_graph.off_help"}}</span>{{end}}
							</label>
						</div>
					</div>
					{{if .CanChange}}
						<button class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
					{{end}}
				</fieldset>
			</form>
			{{if not .CanChange}}
				{{/* outside the disabled label, so it keeps the full text contrast */}}
				<p class="help dependency-graph-decided" id="dependency-graph-set-by">
					{{if not .Switch.Site}}
						{{ctx.Locale.Tr "repo.settings.dependency_graph.site_off"}}
						{{if .CanChangeThere}}<a href="{{AppSubUrl}}/admin/config/dependency-graph">{{ctx.Locale.Tr "repo.settings.dependency_graph.change_in_admin"}}</a>{{else}}{{ctx.Locale.Tr "repo.settings.dependency_graph.ask_admin"}}{{end}}
					{{else}}
						{{if not .Switch.Org.On}}
							{{ctx.Locale.Tr "repo.settings.dependency_graph.org_off" .Repository.OwnerName}}
						{{else}}
							{{if .Switch.Own}}{{ctx.Locale.Tr "repo.settings.dependency_graph.set_by_org" .Repository.OwnerName}}{{else}}{{ctx.Locale.Tr "repo.settings.dependency_graph.set_by_org_own_off" .Repository.OwnerName}}{{end}}
						{{end}}
						{{if .CanChangeThere}}<a href="{{.Repository.Owner.OrganisationLink}}/settings/code_security">{{ctx.Locale.Tr "repo.settings.dependency_graph.change_in_org"}}</a>{{else}}{{ctx.Locale.Tr "repo.settings.dependency_graph.ask_org" .Repository.OwnerName}}{{end}}
					{{end}}
				</p>
			{{end}}
		</div>
		<h4 class="ui top attached header secret-scanning-header">
			{{ctx.Locale.Tr "repo.settings.secret_scanning"}}
		</h4>
		<div class="ui attached segment" id="secret-scanning-box">
			{{if .SecretSwitch.Site}}
			<form class="ui form secret-scanning-switch secret-confirm-form" id="secret-scanning-switch" action="{{.RepoLink}}/settings/code_security/secret_scanning" method="post">
				<fieldset {{if not .SecretCanChange}}disabled{{end}}>
					<div class="field">
						<div class="ui checkbox{{if not .SecretCanChange}} disabled{{end}}">
							<input id="secret-scanning-enabled" name="enabled" type="checkbox" {{if .SecretSwitch.Enabled}}checked{{end}} data-confirm-modal="#secret-scanning-off-modal" data-confirm-when="off">
							<label for="secret-scanning-enabled">
								<strong>{{ctx.Locale.Tr "repo.settings.secret_scanning.enable" .Repository.FullName}}</strong>
								<span class="help">{{ctx.Locale.Tr "repo.settings.secret_scanning.help"}}</span>
							</label>
						</div>
					</div>
					{{if .SecretCanChange}}<button class="ui primary button" id="secret-scanning-save">{{ctx.Locale.Tr "save"}}</button>{{end}}
				</fieldset>
			</form>
			{{else}}
				<p class="help">{{ctx.Locale.Tr "repo.settings.secret_scanning.help"}}</p>
			{{end}}
			<p class="help secret-scanning-decided" id="secret-scanning-set-by">
				{{if not .SecretSwitch.Site}}{{ctx.Locale.Tr "repo.settings.secret_scanning.site_off"}}
				{{else if and .SecretSwitch.Org (not .SecretSwitch.Org.On)}}{{ctx.Locale.Tr "repo.settings.secret_scanning.org_off" .Repository.OwnerName .Repository.OwnerName}}
				{{else if and .SecretSwitch.Org .SecretSwitch.Org.Locked}}{{ctx.Locale.Tr "repo.settings.secret_scanning.org_on" .Repository.OwnerName .Repository.OwnerName}}
				{{else if and (not .SecretSwitch.Own) .SecretOffBy}}{{ctx.Locale.Tr "repo.settings.secret_scanning.off_by" .SecretOffBy (DateUtils.AbsoluteShort .SecretOffAt)}}
				{{end}}
			</p>
		</div>
	</div>
	<dialog class="modal" id="secret-scanning-off-modal" aria-labelledby="secret-scanning-off-heading">
		<article>
			<header id="secret-scanning-off-heading">{{ctx.Locale.Tr "repo.settings.secret_scanning.off_confirm_title" .Repository.FullName}}</header>
			<div class="content">
				<p>{{ctx.Locale.TrPluralString .SecretOpen "repo.settings.secret_scanning.off_confirm" (ctx.Locale.PrettyNumber .SecretOpen)}}</p>
			</div>
			<div class="actions">
				<button type="button" class="ui small basic cancel button">{{svg "octicon-x"}} {{ctx.Locale.Tr "cancel"}}</button>
				<button class="ui small red approve button secret-confirm-ok" id="secret-scanning-off-submit" form="secret-scanning-switch" type="submit">{{ctx.Locale.Tr "repo.settings.secret_scanning.off_submit"}}</button>
			</div>
		</article>
	</dialog>
{{template "repo/settings/layout_footer" .}}
