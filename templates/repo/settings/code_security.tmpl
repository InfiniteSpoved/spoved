{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings code-security")}}
	<div class="repo-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "repo.dependency_graph"}}
		</h4>
		<div class="ui attached segment">
			<form class="ui form" action="{{.RepoLink}}/settings/code_security" method="post">
				<fieldset {{if not .CanChange}}disabled{{end}}>
					<div class="inline field">
						<div class="ui checkbox{{if not .CanChange}} disabled{{end}}">
							<input id="dependency-graph-enabled" name="enabled" type="checkbox" {{if .Switch.Enabled}}checked{{end}}>
							<label for="dependency-graph-enabled"><strong>{{ctx.Locale.Tr "repo.settings.dependency_graph.enable" .Repository.FullName}}</strong></label>
						</div>
						<p class="help" id="dependency-graph-set-by">
							{{if not .Switch.Site}}
								{{ctx.Locale.Tr "repo.settings.dependency_graph.site_off"}}
							{{else if and .Switch.Org (not .Switch.Org.On)}}
								{{ctx.Locale.Tr "repo.settings.dependency_graph.org_off" .Repository.OwnerName}}
							{{else if and .Switch.Org .Switch.Org.Locked}}
								{{ctx.Locale.Tr "repo.settings.dependency_graph.set_by_org" .Repository.OwnerName}}
							{{else}}
								{{ctx.Locale.Tr "repo.settings.dependency_graph.off_help"}}
							{{end}}
						</p>
					</div>
					<button class="ui primary button">{{ctx.Locale.Tr "save"}}</button>
				</fieldset>
			</form>
		</div>
	</div>
{{template "repo/settings/layout_footer" .}}
