{{template "repo/settings/layout_head" (dict "ctxData" . "pageClass" "repository settings")}}
	<div class="repo-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "owned_token.deploy_keys_ssh"}}
			<div class="ui right">
			{{if not .DisableSSH}}
				<button class="ui primary tiny show-panel toggle button" data-panel="#add-deploy-key-panel">{{ctx.Locale.Tr "repo.settings.add_deploy_key"}}</button>
			{{else}}
				<button class="ui primary tiny button disabled">{{ctx.Locale.Tr "settings.ssh_disabled"}}</button>
			{{end}}
			</div>
		</h4>
		<div class="ui attached segment">
			<div class="{{if not .HasError}}tw-hidden{{end}} tw-mb-4" id="add-deploy-key-panel">
				<form class="ui form" action="{{.Link}}" method="post">
					<div class="field">
						{{ctx.Locale.Tr "repo.settings.deploy_key_desc"}}
					</div>
					<div class="field {{if .Err_Title}}error{{end}}">
						<label for="ssh-key-title">{{ctx.Locale.Tr "repo.settings.title"}}</label>
						<input id="ssh-key-title" name="title" value="{{.title}}" autofocus required>
					</div>
					<div class="field {{if .Err_Content}}error{{end}}">
						<label for="ssh-key-content">{{ctx.Locale.Tr "repo.settings.deploy_key_content"}}</label>
						<textarea id="ssh-key-content" name="content" placeholder="{{ctx.Locale.Tr "settings.key_content_ssh_placeholder"}}" required>{{.content}}</textarea>
					</div>
					<div class="field">
						<div class="ui checkbox {{if .Err_IsWritable}}error{{end}}">
							<input id="ssh-key-is-writable" name="is_writable" type="checkbox" value="1">
							<label for="ssh-key-is-writable">
								{{ctx.Locale.Tr "repo.settings.is_writable"}}
							</label>
							<small class="tw-pl-[26px]">{{ctx.Locale.Tr "repo.settings.is_writable_info"}}</small>
						</div>
					</div>
					{{template "shared/expiry_input" .}}
					<button class="ui primary button">
						{{ctx.Locale.Tr "repo.settings.add_deploy_key"}}
					</button>
					<button class="ui hide-panel button" data-panel="#add-deploy-key-panel">
						{{ctx.Locale.Tr "cancel"}}
					</button>
				</form>
			</div>
			{{if .Deploykeys}}
				<div class="flex-list">
					{{range .Deploykeys}}
						<div class="flex-item">
							<div class="flex-item-leading">
								<span class="text {{if .HasRecentActivity}}green{{end}}" {{if .HasRecentActivity}}data-tooltip-content="{{ctx.Locale.Tr "settings.key_state_desc"}}"{{end}}>{{svg "octicon-key" 32}}</span>
							</div>
							<div class="flex-item-main">
								<div class="flex-item-title">{{.Name}}</div>
								<div class="flex-item-body">
									{{.Fingerprint}}
								</div>
								<div class="flex-item-body">
									<p>{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort .CreatedUnix)}} —  {{svg "octicon-info"}} {{if .HasUsed}}{{ctx.Locale.Tr "settings.last_used"}} <span {{if .HasRecentActivity}}class="text green"{{end}}>{{DateUtils.AbsoluteShort .UpdatedUnix}}</span>{{else}}{{ctx.Locale.Tr "settings.no_activity"}}{{end}}{{template "shared/expiry_label" .}} - <span>{{ctx.Locale.Tr "settings.can_read_info"}}{{if not .IsReadOnly}} / {{ctx.Locale.Tr "settings.can_write_info"}} {{end}}</span></p>
								</div>
							</div>
							<div class="flex-item-trailing">
								<button class="ui red tiny button delete-button" data-url="{{$.Link}}/delete" data-id="{{.ID}}" data-modal-id="delete-deploy-key">
									{{ctx.Locale.Tr "settings.delete_key"}}
								</button>
							</div>
						</div>
					{{end}}
				</div>
			{{else}}
				{{ctx.Locale.Tr "repo.settings.no_deploy_keys"}}
			{{end}}
		{{if .OrgDeployKeys}}
			<div class="divider"></div>
			<h5 class="ui header">{{ctx.Locale.Tr "repo.settings.org_deploy_keys"}}</h5>
			<p>{{ctx.Locale.Tr "repo.settings.org_deploy_keys_desc"}}{{if .CanManageOrgDeployKeys}} <a href="{{AppSubUrl}}/org/{{PathEscape .Repository.OwnerName}}/settings/keys">{{ctx.Locale.Tr "repo.settings.org_deploy_keys_manage"}}</a>{{end}}</p>
			<div class="flex-list" id="org-deploy-keys">
				{{range .OrgDeployKeys}}
					<div class="flex-item">
						<div class="flex-item-leading">
							<span class="text {{if .HasRecentActivity}}green{{end}}" {{if .HasRecentActivity}}data-tooltip-content="{{ctx.Locale.Tr "settings.key_state_desc"}}"{{end}}>{{svg "octicon-key" 32}}</span>
						</div>
						<div class="flex-item-main">
							<div class="flex-item-title">{{.Name}}</div>
							<div class="flex-item-body">{{.Fingerprint}}</div>
							<div class="flex-item-body">
								<p>{{ctx.Locale.Tr "settings.added_on" (DateUtils.AbsoluteShort .CreatedUnix)}} — {{svg "octicon-info"}} {{if .HasUsed}}{{ctx.Locale.Tr "settings.last_used"}} <span {{if .HasRecentActivity}}class="text green"{{end}}>{{DateUtils.AbsoluteShort .UpdatedUnix}}</span>{{else}}{{ctx.Locale.Tr "settings.no_activity"}}{{end}}{{template "shared/expiry_label" .}} - <span>{{ctx.Locale.Tr "settings.can_read_info"}}{{if not .IsReadOnly}} / {{ctx.Locale.Tr "settings.can_write_info"}}{{end}}</span></p>
							</div>
							{{if .GroupID}}
							<div class="flex-item-body">
								{{ctx.Locale.Tr "repo.settings.project_deploy_key"}}{{if $.CanManageOrgDeployKeys}} <a href="{{$.Repository.GroupLink}}/-/settings/keys">{{ctx.Locale.Tr "repo.settings.project_deploy_keys_manage"}}</a>{{end}}
							</div>
							{{end}}
						</div>
					</div>
				{{end}}
			</div>
		{{end}}
		</div>
		{{template "shared/owned_tokens" .}}
		{{if .CoveringTokens}}
			<h4 class="ui top attached header tw-mt-4">{{ctx.Locale.Tr "owned_token.covering"}}</h4>
			<div class="ui attached segment">
				<p>{{ctx.Locale.Tr "owned_token.covering_desc"}}{{if .CanManageOrgDeployKeys}} <a href="{{AppSubUrl}}/org/{{PathEscape .Repository.OwnerName}}/settings/keys#access-tokens">{{ctx.Locale.Tr "owned_token.covering_manage"}}</a>{{end}}</p>
				<div class="flex-list" id="covering-access-tokens">
					{{range .CoveringTokens}}
						<div class="flex-item">
							<div class="flex-item-leading">{{svg "fontawesome-send" 32}}</div>
							<div class="flex-item-main">
								<div class="flex-item-title">
									<span {{if .IsExpired}}class="tw-text-text-light-3"{{end}}>{{.Name}}</span>
									<span class="ui tiny basic label">{{if eq .Mode 1}}{{ctx.Locale.Tr "owned_token.permission.read_short"}}{{else if eq .Mode 2}}{{ctx.Locale.Tr "owned_token.permission.write_short"}}{{else}}{{ctx.Locale.Tr "owned_token.permission.admin_short"}}{{end}}</span>
									{{if .IsExpired}}<span class="ui tiny red label">{{ctx.Locale.Tr "owned_token.expired"}}</span>{{end}}
								</div>
								<div class="flex-item-body">{{if .GroupID}}{{ctx.Locale.Tr "owned_token.covering_project"}}{{if $.CanManageOrgDeployKeys}} <a href="{{$.Repository.GroupLink}}/-/settings/keys#access-tokens">{{ctx.Locale.Tr "owned_token.covering_manage"}}</a>{{end}}{{else}}{{ctx.Locale.Tr "owned_token.covering_org"}}{{end}}</div>
								<div class="flex-item-body">{{ctx.Locale.Tr "owned_token.scopes"}}: {{StringUtils.Join .Scope.StringSlice ", "}}{{template "shared/expiry_label" .}}</div>
							</div>
						</div>
					{{end}}
				</div>
			</div>
		{{end}}
	</div>

<div class="ui g-modal-confirm delete modal" id="delete-deploy-key">
	<div class="header">
		{{svg "octicon-trash"}}
		{{ctx.Locale.Tr "repo.settings.deploy_key_deletion"}}
	</div>
	<div class="content">
		<p>{{ctx.Locale.Tr "repo.settings.deploy_key_deletion_desc"}}</p>
	</div>
	{{template "base/modal_actions_confirm" .}}
</div>

{{template "repo/settings/layout_footer" .}}
