<h4 class="ui top attached header" id="wiki">
	{{ctx.Locale.Tr "repo.wiki"}}
</h4>
<div class="ui attached segment">
	{{$isWikiEnabled := or (.Repository.UnitEnabled $.Context $.UnitTypeWiki) (.Repository.UnitEnabled $.Context $.UnitTypeExternalWiki)}}
	{{$isWikiGlobalDisabled := or .UnitTypeWiki.UnitGlobalDisabled ($.UnitHidden.Contains $.UnitTypeWiki)}}
	{{$isExternalWikiGlobalDisabled := or .UnitTypeExternalWiki.UnitGlobalDisabled ($.UnitHidden.Contains $.UnitTypeExternalWiki)}}
	{{$isBothWikiGlobalDisabled := and $isWikiGlobalDisabled $isExternalWikiGlobalDisabled}}
	<div class="inline field">
		<label>{{ctx.Locale.Tr "repo.wiki"}}</label>
		<div class="ui checkbox{{if $isBothWikiGlobalDisabled}} disabled{{end}}"{{if $isBothWikiGlobalDisabled}} data-tooltip-content="{{ctx.Locale.Tr "repo.unit_disabled"}}"{{end}}>
			<input class="enable-system" name="enable_wiki" type="checkbox" data-target="#wiki_box" {{if $isWikiEnabled}}checked{{end}}>
			<label>{{ctx.Locale.Tr "repo.settings.wiki_desc"}}</label>
		</div>
	</div>
	<div class="field{{if not $isWikiEnabled}} disabled{{end}}" id="wiki_box">
		<div class="field">
			<div class="ui radio checkbox{{if $isWikiGlobalDisabled}} disabled{{end}}"{{if $isWikiGlobalDisabled}} data-tooltip-content="{{ctx.Locale.Tr "repo.unit_disabled"}}"{{end}}>
				<input class="enable-system-radio" name="enable_external_wiki" type="radio" value="false" data-context="#globally_writeable_checkbox, #wiki_source_box" data-target="#external_wiki_box" {{if not (.Repository.UnitEnabled $.Context $.UnitTypeExternalWiki)}}checked{{end}}>
				<label>{{ctx.Locale.Tr "repo.settings.use_internal_wiki"}}</label>
			</div>
		</div>
		{{if (not .Repository.IsPrivate)}}
			<div class="field {{if (.Repository.UnitEnabled $.Context $.UnitTypeExternalWiki)}}disabled{{end}}" id="globally_writeable_checkbox">
				<div class="field tw-pl-4">
					<div class="ui checkbox">
						<input name="globally_writeable_wiki" type="checkbox" {{if .Permission.IsGloballyWriteable $.UnitTypeWiki}}checked{{end}}>
						<label>{{ctx.Locale.Tr "repo.settings.wiki_globally_editable"}}</label>
					</div>
				</div>
			</div>
		{{end}}
		{{$wikiConfig := (.Repository.MustGetUnit $.Context $.UnitTypeWiki).WikiConfig}}
		<div class="field tw-pl-4 {{if (.Repository.UnitEnabled $.Context $.UnitTypeExternalWiki)}}disabled{{end}}" id="wiki_source_box">
			<div class="field">
				<div class="ui radio checkbox">
					<input id="wiki_source_separate" name="wiki_source" type="radio" value="separate" {{if not $wikiConfig.FromFolder}}checked{{end}}>
					<label for="wiki_source_separate">{{ctx.Locale.Tr "repo.settings.wiki_source_separate"}}</label>
				</div>
			</div>
			<div class="field">
				<div class="ui radio checkbox">
					<input id="wiki_source_folder" name="wiki_source" type="radio" value="folder" {{if $wikiConfig.FromFolder}}checked{{end}}>
					<label for="wiki_source_folder">{{ctx.Locale.Tr "repo.settings.wiki_source_folder"}}</label>
				</div>
			</div>
			<div class="field tw-pl-4">
				<label for="wiki_folder">{{ctx.Locale.Tr "repo.settings.wiki_folder"}}</label>
				<input id="wiki_folder" name="wiki_folder" maxlength="255" placeholder="docs" value="{{$wikiConfig.Folder}}">
				<p class="help">{{ctx.Locale.Tr "repo.settings.wiki_folder_desc"}}</p>
			</div>
			<div class="field tw-pl-4">
				<label for="wiki_branch">{{ctx.Locale.Tr "repo.settings.wiki_branch"}}</label>
				<input id="wiki_branch" name="wiki_branch" placeholder="{{.Repository.DefaultBranch}}" value="{{$wikiConfig.Branch}}">
				<p class="help">{{ctx.Locale.Tr "repo.settings.wiki_branch_desc"}}</p>
			</div>
		</div>
		<div class="field">
			<div class="ui radio checkbox{{if $isExternalWikiGlobalDisabled}} disabled{{end}}"{{if $isExternalWikiGlobalDisabled}} data-tooltip-content="{{ctx.Locale.Tr "repo.unit_disabled"}}"{{end}}>
				<input class="enable-system-radio" name="enable_external_wiki" type="radio" value="true" data-context="#globally_writeable_checkbox, #wiki_source_box" data-target="#external_wiki_box" {{if .Repository.UnitEnabled $.Context $.UnitTypeExternalWiki}}checked{{end}}>
				<label>{{ctx.Locale.Tr "repo.settings.use_external_wiki"}}</label>
			</div>
		</div>
		<div class="field tw-pl-4 {{if not (.Repository.UnitEnabled $.Context $.UnitTypeExternalWiki)}}disabled{{end}}" id="external_wiki_box">
			<label for="external_wiki_url">{{ctx.Locale.Tr "repo.settings.external_wiki_url"}}</label>
			<input id="external_wiki_url" name="external_wiki_url" type="url" value="{{(.Repository.MustGetUnit $.Context $.UnitTypeExternalWiki).ExternalWikiConfig.ExternalWikiURL}}">
			<p class="help">{{ctx.Locale.Tr "repo.settings.external_wiki_url_desc"}}</p>
		</div>
	</div>

	<div class="divider"></div>

	<div class="field">
		<button class="ui primary button">{{ctx.Locale.Tr "repo.settings.update_settings"}}</button>
	</div>
</div>
