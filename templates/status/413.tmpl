{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content ui {{if .IsRepo}}repository{{end}}">
	{{if .IsRepo}}{{template "repo/header" .}}{{end}}
	<div class="ui container center">
		<h1 style="margin-top: 100px" class="error-code">413</h1>
		{{if .PersonalRepoLocked}}
			{{template "shared/personal_repo_limit" .}}
		{{else}}
			<p>{{ctx.Locale.Tr "error413"}}</p>
		{{end}}
		<p><a id="quota-back" href="{{if .IsRepo}}{{.RepoLink}}{{else}}{{AppSubUrl}}/{{end}}">{{ctx.Locale.Tr "repo.personal_repos.back"}}</a></p>
		<div class="divider"></div>
		<br>
	</div>
</div>
{{template "base/footer" .}}
