<div class="required field {{if .Err_Name}}error{{end}}">
	<label for="name">{{ctx.Locale.Tr "admin.user_groups.name"}}</label>
	<input id="name" name="name" value="{{.name}}" maxlength="255" autofocus required>
	<span class="help">{{ctx.Locale.Tr "admin.user_groups.name_helper"}}</span>
</div>
<div class="field {{if .Err_Description}}error{{end}}">
	<label for="description">{{ctx.Locale.Tr "admin.user_groups.description"}}</label>
	<input id="description" name="description" value="{{.description}}" maxlength="255">
</div>
