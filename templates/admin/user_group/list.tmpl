{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin user-groups")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "admin.user_groups.manage_panel"}} ({{ctx.Locale.Tr "admin.total" .Total}})
			<div class="ui right">
				<a class="ui primary tiny button" href="{{AppSubUrl}}/admin/groups/new">{{ctx.Locale.Tr "admin.user_groups.new"}}</a>
			</div>
		</h4>
		<div class="ui attached segment">
			<form class="ui form ignore-dirty">
				{{template "shared/search/combo" dict "Value" .Keyword "Placeholder" (ctx.Locale.Tr "admin.user_groups.search")}}
			</form>
		</div>
		<div class="ui attached table segment">
			<table class="ui very basic striped table unstackable">
				<thead>
					<tr>
						<th>ID</th>
						<th>{{ctx.Locale.Tr "admin.user_groups.name"}}</th>
						<th>{{ctx.Locale.Tr "admin.user_groups.description"}}</th>
						<th>{{ctx.Locale.Tr "admin.user_groups.members"}}</th>
						<th>{{ctx.Locale.Tr "admin.user_groups.teams"}}</th>
						<th>{{ctx.Locale.Tr "admin.users.created"}}</th>
					</tr>
				</thead>
				<tbody>
					{{range .Groups}}
						<tr>
							<td>{{.ID}}</td>
							<td><a href="{{AppSubUrl}}/admin/groups/{{.ID}}">{{.Name}}</a></td>
							<td>{{.Description}}</td>
							<td>{{.NumMembers}}</td>
							<td>{{.NumTeams}}</td>
							<td>{{DateUtils.AbsoluteShort .CreatedUnix}}</td>
						</tr>
					{{else}}
						<tr><td class="tw-text-center" colspan="6">{{ctx.Locale.Tr "admin.user_groups.none"}}</td></tr>
					{{end}}
				</tbody>
			</table>
		</div>
		{{template "base/paginate" .}}
	</div>
{{template "admin/layout_footer" .}}
