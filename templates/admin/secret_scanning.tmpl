{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin secret-scanning")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "admin.secret_scanning"}}
		</h4>
		<div class="ui attached segment">
			<p>{{ctx.Locale.Tr "admin.secret_scanning.desc"}}</p>
			<p class="help">{{if .UpdatedUnix}}{{ctx.Locale.Tr "admin.secret_scanning.updated" (DateUtils.AbsoluteShort .UpdatedUnix) .UpdatedBy}} {{end}}{{ctx.Locale.Tr "admin.secret_scanning.app_ini" (HTMLFormat "<code>%s</code>" "[secret_scanning]")}}</p>
			{{if not .CanChange}}<p class="ui info message" id="secret-scanning-read-only">{{ctx.Locale.Tr "admin.secret_scanning.read_only"}}</p>{{end}}
			<form class="ui form secret-confirm-form" id="secret-scanning-switches" action="{{AppSubUrl}}/admin/config/secret-scanning/switches" method="post">
				<fieldset{{if not .CanChange}} disabled{{end}}>
					<div class="field">
						<div class="ui checkbox">
							<input id="secret-scanning-enabled" name="enabled" type="checkbox" {{if .Enabled}}checked{{end}} data-confirm-modal="#secret-scanning-site-off-modal" data-confirm-when="off">
							<label for="secret-scanning-enabled">
								<strong>{{ctx.Locale.Tr "admin.secret_scanning.enable"}}</strong>
								<span class="help">{{ctx.Locale.Tr "admin.secret_scanning.enable_help"}}</span>
							</label>
						</div>
					</div>
					{{if ne .FileEnabled .Enabled}}<p class="help" id="secret-scanning-file-default">{{if .FileEnabled}}{{ctx.Locale.Tr "admin.secret_scanning.file_default_on" (HTMLFormat "<code>%s</code>" "[secret_scanning] ENABLED")}}{{else}}{{ctx.Locale.Tr "admin.secret_scanning.file_default_off" (HTMLFormat "<code>%s</code>" "[secret_scanning] ENABLED")}}{{end}}</p>{{end}}
					<div class="field">
						<div class="ui checkbox">
							<input id="secret-scanning-generic" name="generic" type="checkbox" {{if .Generic}}checked{{end}} data-confirm-modal="#secret-scanning-generic-modal" data-confirm-when="on">
							<label for="secret-scanning-generic">
								<strong>{{ctx.Locale.Tr "admin.secret_scanning.generic"}}</strong>
								<span class="help">{{ctx.Locale.Tr "admin.secret_scanning.generic_help"}}</span>
							</label>
						</div>
					</div>
					{{if ne .FileGeneric .Generic}}<p class="help" id="secret-scanning-generic-file-default">{{if .FileGeneric}}{{ctx.Locale.Tr "admin.secret_scanning.file_default_on" (HTMLFormat "<code>%s</code>" "[secret_scanning] GENERIC_RULES")}}{{else}}{{ctx.Locale.Tr "admin.secret_scanning.file_default_off" (HTMLFormat "<code>%s</code>" "[secret_scanning] GENERIC_RULES")}}{{end}}</p>{{end}}
					{{if .CanChange}}
						<button class="ui primary button" id="secret-scanning-switches-save">{{ctx.Locale.Tr "admin.secret_scanning.save"}}</button>
						<span class="help">{{ctx.Locale.Tr "admin.secret_scanning.audit_note"}}</span>
					{{end}}
				</fieldset>
			</form>
		</div>

		<h4 class="ui attached header">{{ctx.Locale.Tr "admin.secret_scanning.limits"}}</h4>
		<div class="ui attached segment">
			<p class="help">{{ctx.Locale.Tr "admin.secret_scanning.limits_help"}} {{.LimitFloors}}</p>
			<form class="ui form" id="secret-scanning-limits" action="{{AppSubUrl}}/admin/config/secret-scanning/limits" method="post" novalidate>
				{{if .LimitsError}}<div class="ui negative message" id="secret-scanning-limits-error" role="alert" tabindex="-1"><a href="#secret-limit-{{.LimitsErrorField}}">{{.LimitsError}}</a></div>{{end}}
				<fieldset{{if not .CanChange}} disabled{{end}}>
					{{range .Limits}}
					<div class="field secret-scanning-limit{{if .Error}} error{{end}}">
						<label for="secret-limit-{{.Name}}">{{.Label}}</label>
						<div class="ui right labeled input">
							<input id="secret-limit-{{.Name}}" name="{{.Name}}" type="text" inputmode="decimal" value="{{.Value}}" autocomplete="off" aria-describedby="secret-limit-{{.Name}}-default{{if .Error}} secret-scanning-limits-error{{end}}"{{if .Error}} aria-invalid="true" autofocus{{end}}>
							{{if .Unit}}<span class="ui basic label">{{.Unit}}</span>{{end}}
						</div>
						<p class="help" id="secret-limit-{{.Name}}-default">{{ctx.Locale.Tr "admin.secret_scanning.app_default" .Default}}</p>
					</div>
					{{end}}
					<p class="help secret-scanning-at-limit">{{ctx.Locale.Tr "admin.secret_scanning.limits_at_limit"}}</p>
					{{if .CanChange}}<button class="ui primary button" id="secret-scanning-limits-save">{{ctx.Locale.Tr "admin.secret_scanning.limits_save"}}</button>
					<p class="help secret-scanning-audit-note">{{ctx.Locale.Tr "admin.secret_scanning.audit_note"}}</p>{{end}}
				</fieldset>
			</form>
		</div>
	</div>
<dialog class="modal" id="secret-scanning-site-off-modal" aria-labelledby="secret-scanning-site-off-heading">
	<article>
		<header id="secret-scanning-site-off-heading">{{ctx.Locale.Tr "admin.secret_scanning.site_off_title"}}</header>
		<div class="content"><p>{{ctx.Locale.Tr "admin.secret_scanning.site_off_confirm"}}</p></div>
		<div class="actions">
			<button type="button" class="ui small basic cancel button">{{svg "octicon-x"}} {{ctx.Locale.Tr "cancel"}}</button>
			<button class="ui small red approve button secret-confirm-ok" form="secret-scanning-switches" type="submit">{{ctx.Locale.Tr "admin.secret_scanning.site_off_submit"}}</button>
		</div>
	</article>
</dialog>
<dialog class="modal" id="secret-scanning-generic-modal" aria-labelledby="secret-scanning-generic-heading">
	<article>
		<header id="secret-scanning-generic-heading">{{ctx.Locale.Tr "admin.secret_scanning.generic_title"}}</header>
		<div class="content"><p>{{ctx.Locale.Tr "admin.secret_scanning.generic_confirm"}}</p></div>
		<div class="actions">
			<button type="button" class="ui small basic cancel button">{{svg "octicon-x"}} {{ctx.Locale.Tr "cancel"}}</button>
			<button class="ui small primary approve button secret-confirm-ok" form="secret-scanning-switches" type="submit">{{ctx.Locale.Tr "admin.secret_scanning.generic_submit"}}</button>
		</div>
	</article>
</dialog>
{{template "admin/layout_footer" .}}
