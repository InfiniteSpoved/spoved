{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin security-search")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header" id="custom-patterns">{{.Title}}</h4>
		<div class="ui attached segment">
			{{if not .SecretSiteOn}}<div class="ui warning message" id="secret-patterns-site-off">{{ctx.Locale.Tr "secret_pattern.site_off"}}</div>{{end}}
			{{template "shared/secret_patterns" .}}
		</div>
	</div>
{{template "admin/layout_footer" .}}
