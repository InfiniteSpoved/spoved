{{/* One numeric field of the dependency graph settings: Name, Label, Unit ("" for none), Field (Value, Default), Help. */}}
<div class="field dg-field">
	<label for="dg-{{.Name}}">{{.Label}}</label>
	<div class="dg-unit-input">
		<input id="dg-{{.Name}}" name="{{.Name}}" type="number" inputmode="numeric" min="1" value="{{.Field.Value}}">
		{{if .Unit}}<span class="dg-unit">{{.Unit}}</span>{{end}}
	</div>
	{{if or .Help .Field.Default}}<p class="help">{{if .Help}}{{.Help}}{{end}}{{if .Field.Default}} <span class="dg-app-default">{{ctx.Locale.Tr "admin.dependency_graph.settings.app_default" .Field.Default}}</span>{{end}}</p>{{end}}
</div>
