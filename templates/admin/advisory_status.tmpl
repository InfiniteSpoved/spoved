{{/* The status of one ecosystem of the advisory mirror: the dot holds the error class ("" for OK) and whether data from an earlier update exists. Never raw text. */}}
{{if eq .Error ""}}<span class="text green">{{ctx.Locale.Tr "admin.dependency_graph.advisories.ok"}}</span>
{{else}}<span class="text yellow">{{if eq .Error "blocked_host"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.blocked_host"}}{{if $.HasData}}; {{ctx.Locale.Tr "admin.dependency_graph.advisories.old_data_kept"}}{{end}}
{{else if eq .Error "connection_failed"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.connection_failed"}}{{if $.HasData}}; {{ctx.Locale.Tr "admin.dependency_graph.advisories.old_data_kept"}}{{end}}
{{else if eq .Error "timeout"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.timeout"}}
{{else if eq .Error "status 4xx"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.status_4xx"}}{{if $.HasData}}; {{ctx.Locale.Tr "admin.dependency_graph.advisories.old_data_kept"}}{{end}}
{{else if eq .Error "status 5xx"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.status_5xx"}}{{if $.HasData}}; {{ctx.Locale.Tr "admin.dependency_graph.advisories.old_data_kept"}}{{end}}
{{else if eq .Error "too_large"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.too_large"}}
{{else if eq .Error "too_many_entries"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.too_many_entries"}}{{if $.HasData}}; {{ctx.Locale.Tr "admin.dependency_graph.advisories.old_data_kept"}}{{end}}
{{else if eq .Error "bad_zip"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.bad_zip"}}
{{else if eq .Error "too_many_skipped"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.too_many_skipped"}}
{{else if eq .Error "shrunk"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.shrunk"}}{{if $.HasData}}; {{ctx.Locale.Tr "admin.dependency_graph.advisories.old_data_kept"}}{{end}}
{{else if eq .Error "mass_withdrawn"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.mass_withdrawn"}}
{{else if eq .Error "auth_failed"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.auth_failed"}}{{if $.HasData}}; {{ctx.Locale.Tr "admin.dependency_graph.advisories.old_data_kept"}}{{end}}
{{else if eq .Error "config_invalid"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.config_invalid"}}{{if $.HasData}}; {{ctx.Locale.Tr "admin.dependency_graph.advisories.old_data_kept"}}{{end}}
{{else if eq .Error "redirect_refused"}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.redirect_refused"}}{{if $.HasData}}; {{ctx.Locale.Tr "admin.dependency_graph.advisories.old_data_kept"}}{{end}}
{{else}}{{ctx.Locale.Tr "admin.dependency_graph.advisories.error.internal_error"}}{{end}}</span>{{end}}
