<!DOCTYPE html>
<html>
<head>
	<style>
		.footer { font-size:small; color:#666;}
		th, td { text-align:start; padding:2px 16px 2px 0; }
	</style>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
	<title>{{.Title}}</title>
</head>

<body>
	<h1>{{.Title}}</h1>
	<p>{{.Intro}}</p>
	<table>
		<tr><th>{{.locale.Tr "mail.secret_digest.col_type"}}</th><th>{{.locale.Tr "mail.secret_digest.col_found"}}</th></tr>
		{{range .Types}}<tr><td>{{.Name}}</td><td>{{.Count}}</td></tr>
		{{end}}
	</table>
	{{if .Places}}
	<p><b>{{.PlacesHead}}</b></p>
	<ul>
		{{range .Places}}<li><code>{{.}}</code></li>
		{{end}}
	</ul>
	{{with .More}}<p>{{.}}</p>{{end}}
	{{end}}
	<p>{{.Advice}}</p>
	<p><a href="{{.Link}}">{{.LinkText}}</a></p>
	<div class="footer">
		<p>
			---
			<br>
			{{.Footer}} <a href="{{.Settings}}">{{.locale.Tr "mail.secret_digest.settings"}}</a>
		</p>
	</div>
</body>
</html>
