<!DOCTYPE html>
<html>
<head>
	<style>
		.footer { font-size:small; color:#6b7280;}
		.footer a { color:#2563eb;}
	</style>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
	<title>{{.Title}}</title>
</head>

<body>
	<h1>{{.Title}}</h1>
	<p>{{.Intro}}</p>
	<ul>
		{{range .Types}}<li>{{.Name}}: {{.Count}}</li>
		{{end}}
	</ul>
	{{if .Places}}
	<p><b>{{.PlacesHead}}</b></p>
	<ul>
		{{range .Places}}<li><code>{{.}}</code></li>
		{{end}}
	</ul>
	{{with .More}}<p>{{.}}</p>{{end}}
	{{end}}
	{{with .TextNote}}<p>{{.}}</p>{{end}}
	<p><a href="{{.Link}}" style="display:inline-block; padding:8px 16px; background:#2563eb; color:#fff; text-decoration:none; border-radius:4px;">{{.LinkText}}</a></p>
	<p>{{.Advice}}</p>
	{{with .Notified}}<p>{{.}}</p>{{end}}
	<div class="footer">
		<p>
			---
			<br>
			{{.Footer}} <a href="{{.Settings}}">{{.locale.Tr "mail.secret_digest.settings"}}</a>
		</p>
	</div>
</body>
</html>
