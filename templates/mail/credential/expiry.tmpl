<!DOCTYPE html>
<html>
<head>
	<style>
		.footer { font-size:small; color:#666;}
	</style>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
</head>

<body>
	<p>{{.locale.Tr "mail.credential_expiry.body" .Kind .Name .Owner .Expires}}</p>
	<p>{{.locale.Tr "mail.credential_expiry.effect"}}</p>
	<p>
		{{if .IsToken}}{{.locale.Tr "mail.credential_expiry.rotate"}}{{else}}{{.locale.Tr "mail.credential_expiry.replace"}}{{end}}
		<a href="{{.Link}}">{{.locale.Tr "mail.credential_expiry.open"}}</a>
	</p>
	<div class="footer">
		<p>
			---
			<br>
			{{.Reason}} <a href="{{.SettingsLink}}">{{.locale.Tr "mail.credential_expiry.settings"}}</a>
		</p>
	</div>
</body>
</html>
