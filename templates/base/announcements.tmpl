{{if and .Maintenance .Maintenance.ReadOnly}}
	<div class="ui warning message site-announcement tw-flex tw-items-start tw-gap-2" id="maintenance-banner">
		<div class="tw-flex-1">
			<strong>{{if .Maintenance.Full}}{{ctx.Locale.Tr "maintenance.full"}}{{else}}{{ctx.Locale.Tr "maintenance.read_only"}}{{end}}</strong>
			{{if .Maintenance.Message}}: {{.Maintenance.Message}}{{end}}
			{{if .Maintenance.Until}}<br>{{ctx.Locale.Tr "maintenance.until" (DateUtils.FullTime .Maintenance.Until)}}{{end}}
		</div>
	</div>
{{end}}
{{$announcements := and .SiteAnnouncements (call .SiteAnnouncements)}}
{{if $announcements}}
	<div id="site-announcements" class="site-announcements">
		{{range $announcements}}
			<div class="ui {{if eq .Type "critical"}}negative{{else if eq .Type "warning"}}warning{{else}}info{{end}} message site-announcement tw-flex tw-items-start tw-gap-2" data-announcement-id="{{.ID}}" data-announcement-type="{{.Type}}">
				<div class="render-content markup tw-flex-1">{{.RenderedMessage}}</div>
				{{if and $.IsSigned .CanBeDismissed}}
					<form class="tw-shrink-0" method="post" action="{{AppSubUrl}}/-/announcements/{{.ID}}/dismiss">
						<input type="hidden" name="redirect_to" value="{{$.CurrentURL}}">
						<button class="ui mini basic icon button" type="submit" data-tooltip-content="{{ctx.Locale.Tr "announcements.dismiss"}}" aria-label="{{ctx.Locale.Tr "announcements.dismiss"}}">{{svg "octicon-x"}}</button>
					</form>
				{{end}}
			</div>
		{{end}}
	</div>
{{end}}
